+#[test]
+fn diagonal_and_chunk_section_neighbors_reach_the_real_mesher() {
+    let f = Fixture::new(128, false);
+    f.rules(128);
+    let a = f.assets();
+    let r = f.render(&a);
+    let corner = center(&[[4, 4, 4], [5, 4, 4], [4, 5, 4]]);
+    let filled = center(&[[4, 4, 4], [5, 4, 4], [4, 5, 4], [5, 5, 4]]);
+    assert_ne!(
+        layer_at(&f.mesh(&a, &r, &corner, None, 0), [4, 4, 4]),
+        layer_at(&f.mesh(&a, &r, &filled, None, 0), [4, 4, 4])
+    );
+    let isolated = center(&[[15, 15, 4]]);
+    let vertical = center(&[[15, 15, 4], [15, 16, 4]]);
+    let mut east = Chunk::empty(1, 0);
+    east.set(0, MIN_Y + 15, 4, 1);
+    east.set(0, MIN_Y + 16, 4, 1);
+    let none = f.mesh(&a, &r, &isolated, None, 0);
+    let edge = f.mesh(&a, &r, &vertical, Some(&east), 0);
+    assert_ne!(layer_at(&none, [15, 15, 4]), layer_at(&edge, [15, 15, 4]));
+    assert_eq!(
+        layer_at(&edge, [15, 15, 4]),
+        layer_at(&f.mesh(&a, &r, &filled, None, 0), [4, 4, 4])
+    );
+}
