+#[test]
+fn emissive_overlay_uses_selected_connected_texture_not_original_sprite() {
+    let f = Fixture::new(255, false);
+    f.rules(255);
+    f.write(
+        "assets/minecraft/optifine/emissive.properties",
+        "suffix.emissive=_e\n",
+    );
+    f.png(
+        "assets/minecraft/textures/block/glass_e.png",
+        [255, 1, 2, 255],
+    );
+    let assets = f.assets();
+    let chunk = center(&[[4, 2, 3]]);
+    let render = f.render(&assets);
+    let before = f.mesh(&assets, &render, &chunk, None, 0);
+    assert_eq!(
+        before.solid.len(),
+        4,
+        "unmatched original emissive texture must not bleed into a CTM tile"
+    );
+    let tile = u32::from(layer_at(&before, [4, 2, 3]));
+    let name = render
+        .sprite_layers
+        .iter()
+        .find_map(|(name, &l)| {
+            (l == tile && name.starts_with("@resource:")).then_some(name.clone())
+        })
+        .unwrap();
+    let path = name.strip_prefix("@resource:minecraft:").unwrap();
+    f.png(&format!("assets/minecraft/{path}_e.png"), [1, 255, 2, 255]);
+    let render = f.render(&assets);
+    let after = f.mesh_lighting(&assets, &render, &chunk, None, 0, true);
+    assert_eq!(after.solid.len(), 8);
+    assert_eq!(
+        after.solid[4].layer as u32,
+        render.emissive_layers[&u32::from(layer_at(&after, [4, 2, 3]))]
+    );
+    assert_eq!(after.solid[4].color, 0xAFFF_FFFF);
+}
