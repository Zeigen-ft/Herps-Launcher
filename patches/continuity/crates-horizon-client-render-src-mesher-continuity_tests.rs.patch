+#[test]
+fn adjacent_glass_changes_real_mesh_and_reload_removes_rules() {
+    let f = Fixture::new(128, false);
+    let assets = f.assets();
+    let plain = f.render(&assets);
+    let chunk = center(&[[4, 4, 4], [5, 4, 4]]);
+    let original = f.mesh(&assets, &plain, &chunk, None, 0);
+    assert!(plain.connected_textures.is_empty());
+    assert_eq!(original.solid.len(), 0);
+    assert_eq!(original.translucent.len(), 8);
+    let base = layer_at(&original, [4, 4, 4]);
+    f.rules(128);
+    let connected = f.render(&assets);
+    assert_eq!(connected.connected_textures.rule_count(), 1);
+    let mesh = f.mesh(&assets, &connected, &chunk, None, 0);
+    assert_eq!(mesh.solid.len(), 0);
+    assert_eq!(mesh.translucent.len(), 8);
+    assert_ne!(layer_at(&mesh, [4, 4, 4]), base);
+    assert_ne!(layer_at(&mesh, [4, 4, 4]), layer_at(&mesh, [5, 4, 4]));
+    fs::remove_dir_all(f.0.join("assets/minecraft/optifine")).unwrap();
+    let reloaded = f.render(&assets);
+    let restored = f.mesh(&assets, &reloaded, &chunk, None, 0);
+    assert!(reloaded.connected_textures.is_empty());
+    assert_eq!(layer_at(&restored, [4, 4, 4]), base);
+    assert_eq!(
+        bytemuck::cast_slice::<TerrainVertex, u8>(&restored.translucent),
+        bytemuck::cast_slice::<TerrainVertex, u8>(&original.translucent)
+    );
+}
