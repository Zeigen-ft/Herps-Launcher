+#[test]
+fn symlinked_overlay_properties_and_replacement_images_are_loaded() {
+    let f = Fixture::new(128, false);
+    f.rules(128);
+    let src = f.0.join("assets/minecraft/optifine/ctm/test");
+    let external = f.0.join("original-pack-files");
+    fs::create_dir_all(&external).unwrap();
+    for name in
+        std::iter::once("glass.properties".to_owned()).chain((0..47).map(|i| format!("{i}.png")))
+    {
+        fs::rename(src.join(&name), external.join(&name)).unwrap();
+        std::os::unix::fs::symlink(external.join(&name), src.join(&name)).unwrap();
+    }
+    let condition = f.0.join("assets/minecraft/textures/block/glass.png");
+    fs::rename(&condition, external.join("glass-base.png")).unwrap();
+    std::os::unix::fs::symlink(external.join("glass-base.png"), &condition).unwrap();
+    let a = f.assets();
+    let r = f.render(&a);
+    assert_eq!(r.connected_textures.rule_count(), 1);
+    let mesh = f.mesh(&a, &r, &center(&[[4, 4, 4], [5, 4, 4]]), None, 0);
+    assert_eq!(mesh.translucent.len(), 8);
+}
