+#[test]
+fn emissive_tinted_leaf_overlay_bypasses_ao_and_keeps_cutouts() {
+    let f = Fixture::new(255, false);
+    f.write(
+        "assets/minecraft/models/block/glass.json",
+        &json!({
+            "ambientocclusion":true,
+            "textures":{"all":"minecraft:block/glass"},
+            "elements":[{"from":[0,0,0],"to":[16,16,16],"faces":{
+                "south":{"texture":"#all","tintindex":0,"uv":[0,0,16,16]}
+            }}]
+        })
+        .to_string(),
+    );
+    f.write(
+        "assets/minecraft/optifine/emissive.properties",
+        "suffix.emissive=_e\n",
+    );
+    f.png(
+        "assets/minecraft/textures/block/glass_e.png",
+        [255, 255, 255, 128],
+    );
+    let assets = f.assets();
+    let render = f.render(&assets);
+    let chunk = center(&[[4, 2, 3], [5, 2, 4]]);
+    let mesh = f.mesh_configure(&assets, &render, &chunk, None, 0, true, |glass| {
+        glass.tints = [Tint::Constant(0x4080c0), Tint::None];
+        glass.tint_count = 1;
+        glass.full = true;
+        glass.permeable = false;
+        glass.shade = 0.2;
+        glass.leaves = true;
+    });
+    assert!(mesh.translucent.is_empty());
+    let base = &mesh.solid[..4];
+    let overlay = &mesh.solid[4..8];
+    assert!(base.iter().all(|v| v.layer & OPAQUE_LAYER != 0));
+    assert!(overlay.iter().all(|v| v.layer & OPAQUE_LAYER == 0));
+    assert!(overlay.iter().all(|v| v.color == 0xAFC0_8040));
+    assert!(base.iter().all(|v| v.color & 0xFF < 0x40));
+    assert!(
+        base.windows(2).any(|v| v[0].color != v[1].color),
+        "occluding neighbor must exercise ambient occlusion"
+    );
+}
