+#[test]
+#[ignore = "requires HERPS_CONTINUITY_PACK pointing to the extracted uploaded Continuity default resource pack"]
+fn uploaded_default_pack_loads_all_42_rules_and_changes_real_glass_mesh() {
+    use std::io::Read;
+    let input = std::env::var_os("HERPS_CONTINUITY_PACK")
+        .expect("HERPS_CONTINUITY_PACK must be set for the exact-input validation");
+    let f = Fixture::new(128, false);
+    let mut zip = zip::ZipArchive::new(fs::File::open(input).unwrap()).unwrap();
+    for i in 0..zip.len() {
+        let mut entry = zip.by_index(i).unwrap();
+        if entry.is_dir() {
+            continue;
+        }
+        let relative = entry.enclosed_name().unwrap();
+        let out = f.0.join(relative);
+        fs::create_dir_all(out.parent().unwrap()).unwrap();
+        let mut bytes = Vec::new();
+        entry.read_to_end(&mut bytes).unwrap();
+        fs::write(out, bytes).unwrap();
+    }
+    let ctm = f.0.join("assets/continuity/optifine/ctm/default");
+    fn populate_conditions(root: &Path, dir: &Path) {
+        for entry in fs::read_dir(dir).unwrap() {
+            let path = entry.unwrap().path();
+            if path.is_dir() {
+                populate_conditions(root, &path);
+                continue;
+            }
+            if path.extension().and_then(|e| e.to_str()) != Some("properties") {
+                continue;
+            }
+            let text = fs::read_to_string(&path).unwrap();
+            if let Some(relative) = text
+                .lines()
+                .find_map(|line| line.trim().strip_prefix("resourceCondition="))
+            {
+                let target = root.join("assets/minecraft").join(relative);
+                fs::create_dir_all(target.parent().unwrap()).unwrap();
+                fs::copy(path.parent().unwrap().join("0.png"), target).unwrap();
+            }
+        }
+    }
+    populate_conditions(&f.0, &ctm);
+    let a = f.assets();
+    let r = f.render(&a);
+    assert_eq!(r.connected_textures.rule_count(), 42);
+    let single = f.mesh(&a, &r, &center(&[[4, 4, 4]]), None, 0);
+    let joined = f.mesh(&a, &r, &center(&[[4, 4, 4], [5, 4, 4]]), None, 0);
+    assert_ne!(layer_at(&single, [4, 4, 4]), layer_at(&joined, [4, 4, 4]));
+    let selected = usize::from(layer_at(&joined, [4, 4, 4]));
+    let bytes = (r.sprite_size * r.sprite_size * 4) as usize;
+    assert!(
+        r.pixels[selected * bytes..(selected + 1) * bytes]
+            .iter()
+            .any(|&v| v != 0)
+    );
+    println!(
+        "Original Continuity default pack: 42 rules loaded; connected glass changed an actual section mesh; selected replacement pixels are nonempty."
+    );
+}
