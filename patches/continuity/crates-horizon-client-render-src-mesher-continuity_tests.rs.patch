+#[test]
+fn emissive_overlay_preserves_base_geometry_and_reloads_cleanly() {
+    for (alpha, forced) in [(255, false), (128, false), (255, true)] {
+        let f = Fixture::new(alpha, forced);
+        let assets = f.assets();
+        let chunk = center(&[[4, 2, 3]]);
+        let before = f.mesh(&assets, &f.render(&assets), &chunk, None, 0);
+        f.write(
+            "assets/minecraft/optifine/emissive.properties",
+            "suffix.emissive=_e\n",
+        );
+        f.png(
+            "assets/minecraft/textures/block/glass_e.png",
+            [200, 100, 20, 128],
+        );
+        let render = f.render(&assets);
+        let mut after = f.mesh(&assets, &render, &chunk, None, 0);
+        let (base, glowing) = if forced || alpha != 255 {
+            assert!(after.solid.is_empty());
+            (&before.translucent, &after.translucent)
+        } else {
+            assert!(after.translucent.is_empty());
+            (&before.solid, &after.solid)
+        };
+        assert_eq!(base.len(), 4);
+        assert_eq!(glowing.len(), 8);
+        assert_eq!(
+            bytemuck::cast_slice::<_, u8>(base),
+            bytemuck::cast_slice::<_, u8>(&glowing[..4])
+        );
+        let selected = u32::from(glowing[0].layer & !OPAQUE_LAYER);
+        for (b, e) in glowing[..4].iter().zip(&glowing[4..]) {
+            assert_eq!(b.pos, e.pos);
+            assert_eq!(b.uv, e.uv);
+            assert_eq!(e.layer as u32, render.emissive_layers[&selected]);
+            assert_eq!(
+                e.layer & OPAQUE_LAYER,
+                0,
+                "transparent overlay stays cutout even on an opaque base"
+            );
+            assert_eq!(e.color, 0xAFFF_FFFF);
+            assert_eq!(e.light, pack_coords(lighting::FULL_BRIGHT));
+            assert_ne!(
+                b.color & 0x00FF_FFFF,
+                e.color & 0x00FF_FFFF,
+                "south-face shading applies only to base"
+            );
+        }
+        // Sorting the solid mesh keeps coplanar overlays after their bases.
+        after.sort_solid();
+        if !after.solid.is_empty() {
+            assert_eq!(after.solid[4].color & 0xF000_0000, EMISSIVE_COLOR);
+        }
+        fs::remove_file(f.0.join("assets/minecraft/optifine/emissive.properties")).unwrap();
+        let restored = f.mesh(&assets, &f.render(&assets), &chunk, None, 0);
+        assert_eq!(
+            bytemuck::cast_slice::<_, u8>(&before.solid),
+            bytemuck::cast_slice::<_, u8>(&restored.solid)
+        );
+        assert_eq!(
+            bytemuck::cast_slice::<_, u8>(&before.translucent),
+            bytemuck::cast_slice::<_, u8>(&restored.translucent)
+        );
+    }
+}
