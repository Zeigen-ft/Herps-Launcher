+    fn linked_overlay_property_png_and_condition_files_load() {
+        use std::os::unix::fs::symlink;
+        let scratch = std::env::temp_dir().join(format!(
+            "horizon-ctm-links-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        fs::create_dir_all(&scratch).unwrap();
+        struct Cleanup(PathBuf);
+        impl Drop for Cleanup {
+            fn drop(&mut self) {
+                let _ = fs::remove_dir_all(&self.0);
+            }
+        }
+        let _cleanup = Cleanup(scratch.clone());
+        let source = scratch.join("source");
+        let root = scratch.join("overlay");
+        let dir = root.join("assets/continuity/optifine/ctm/glass");
+        fs::create_dir_all(&source).unwrap();
+        fs::create_dir_all(&dir).unwrap();
+        fs::create_dir_all(root.join("assets/minecraft/textures/block")).unwrap();
+        let png = source.join("glass.png");
+        {
+            let mut encoder = png::Encoder::new(fs::File::create(&png).unwrap(), 16, 16);
+            encoder.set_color(png::ColorType::Rgba);
+            encoder.set_depth(png::BitDepth::Eight);
+            let mut writer = encoder.write_header().unwrap();
+            writer
+                .write_image_data(&[180, 210, 240, 128].repeat(256))
+                .unwrap();
+        }
+        symlink(&png, root.join("assets/minecraft/textures/block/glass.png")).unwrap();
+        for n in 0..4 {
+            symlink(&png, dir.join(format!("{n}.png"))).unwrap();
+        }
+        let document = source.join("rule.properties");
+        fs::write(&document,"method=horizontal\nmatchTiles=glass\nmatchBlocks=glass\ntiles=0-3\nresourceCondition=textures/block/glass.png\n").unwrap();
+        symlink(&document, dir.join("glass.properties")).unwrap();
+        let mut files = Vec::new();
+        gather(&dir, 0, "continuity", &mut files).unwrap();
+        assert_eq!(files.len(), 1);
+        let mut sprites = Sprites::default();
+        sprites.insert(&root, "minecraft:block/glass").unwrap();
+        let parsed = parse_rule(&root, &files[0].0, files[0].1.clone(), &mut sprites)
+            .unwrap()
+            .unwrap();
+        assert_eq!(parsed.method, Method::Horizontal);
+        assert_eq!(parsed.tiles.len(), 4);
+    }
