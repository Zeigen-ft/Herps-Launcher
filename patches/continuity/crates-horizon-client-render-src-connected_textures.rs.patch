+    #[test]
+    fn pane_flipped_uv_connects_the_border_in_texture_space() {
+        // The included pane-side template's west face reverses U (16 -> 9).
+        let pane = quad(Direction::West, [16.0, 0.0, 9.0, 16.0]);
+        assert_eq!(quad_axes(&pane), Some(([0, 1, 0], [0, 0, -1])));
+        let ctm = fixture(Method::Ctm, Connect::Block, 0x3f);
+        let got = ctm.replacement_for_quad(BlockStateId(1), 5, &pane, BlockPos::default(), |p| {
