+    }
+    #[test]
+    fn rotated_uv_axes_and_degenerate_quads_are_handled() {
+        let mut q = quad(Direction::West, [0.0, 0.0, 16.0, 16.0]);
+        let (old_up, old_right) = quad_axes(&q).unwrap();
+        q.uv = q.uv.map(|[u, v]| [v, 1.0 - u]);
+        assert_eq!(quad_axes(&q), Some((old_right, neg(old_up))));
+        q.uv = [[0.0; 2]; 4];
+        assert_eq!(quad_axes(&q), None);
+        assert_eq!(
+            fixture(Method::Ctm, Connect::Block, 0x3f).replacement_for_quad(
+                BlockStateId(1),
+                5,
+                &q,
+                BlockPos::default(),
+                |_| BlockStateId(1)
+            ),
+            None
+        );
