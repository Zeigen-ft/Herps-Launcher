+    #[test]
+    fn ctm_replacement_connects_across_section_boundaries_on_every_face() {
+        let ctm = fixture(Method::Ctm, Connect::Block, 0x3f);
+        for face in Direction::ALL {
+            let p = BlockPos::new(15, 15, -16);
+            let (up, right) = axes(face);
+            let neighbors = BTreeSet::from(
+                [
+                    p.offset(up[0], up[1], up[2]),
+                    p.offset(right[0], right[1], right[2]),
+                    p.offset(up[0] + right[0], up[1] + right[1], up[2] + right[2]),
+                ]
+                .map(|p| (p.x, p.y, p.z)),
+            );
+            let got = ctm.replacement(BlockStateId(1), 5, face, p, |n| {
+                if neighbors.contains(&(n.x, n.y, n.z)) {
+                    BlockStateId(2)
+                } else {
+                    BlockStateId(0)
+                }
+            });
+            assert_eq!(got, Some(100 + ctm_index(1 | 2 | 16) as u32));
+        }
+    }
+    #[test]
+    fn horizontal_tiles_distinguish_endcaps_and_middle() {
+        let ctm = fixture(Method::Horizontal, Connect::Block, 0x3c);
+        let p = BlockPos::default();
