+    #[test]
+    fn emissive_invalid_or_missing_overlay_keeps_base_and_missing_config_disables_it() {
+        let root = Fixture::new();
+        root.emissive();
+        for name in ["missing", "broken"] {
+            root.png(
+                &format!("assets/test/textures/block/{name}.png"),
+                [90, 80, 70, 255],
+            );
+        }
+        root.text("assets/test/textures/block/broken_e.png", "not a PNG");
+        let mut sprites = Sprites::default();
+        let base = sprites.insert(&root.0, "test:block/missing").unwrap();
+        assert_eq!(sprites.insert(&root.0, "test:block/broken").unwrap(), base);
+        assert!(sprites.emissive_layers.is_empty());
+        root.png("assets/test/textures/block/missing_e.png", [5, 6, 7, 255]);
+        fs::remove_file(root.0.join("assets/minecraft/optifine/emissive.properties")).unwrap();
+        let mut after = Sprites::default();
+        after.insert(&root.0, "test:block/missing").unwrap();
+        assert!(after.emissive_layers.is_empty());
+        after.finish();
+        assert_eq!(&after.pixels[..4], &[90, 80, 70, 255]);
+    }
+
+    #[test]
+    fn emissive_ctm_reload_rebuilds_overlay_pixels_and_config() {
+        let root = Fixture::new();
+        root.emissive();
+        root.png("assets/test/optifine/ctm/a/0.png", [10, 20, 30, 255]);
+        root.png("assets/test/optifine/ctm/a/0_e.png", [200, 0, 0, 255]);
+        let mut before = Sprites::with_disk_cache(&root.0);
+        let base = before
+            .insert_resource(&root.0, "test:optifine/ctm/a/0")
+            .unwrap();
+        assert_eq!(before.emissive_layers.len(), 1);
+        assert!(before.emissive_layers.contains_key(&base));
+        before.save_disk_cache();
+        root.png("assets/test/optifine/ctm/a/0_e.png", [0, 200, 0, 255]);
+        let mut after = Sprites::with_disk_cache(&root.0);
+        let base = after
+            .insert_resource(&root.0, "test:optifine/ctm/a/0")
+            .unwrap();
+        let overlay = after.emissive_layers[&base];
+        after.finish();
+        assert_eq!(
+            &after.pixels[overlay as usize * 1024..][..4],
+            &[0, 200, 0, 255]
+        );
+        root.text(
+            "assets/minecraft/optifine/emissive.properties",
+            "suffix.emissive=../unsafe",
+        );
+        let mut disabled = Sprites::with_disk_cache(&root.0);
+        disabled
+            .insert_resource(&root.0, "test:optifine/ctm/a/0")
+            .unwrap();
+        assert!(disabled.emissive_layers.is_empty());
+    }
