+#[cfg(test)]
+mod ctm_resource_tests {
+    use super::*;
+    struct Fixture(std::path::PathBuf);
+    impl Fixture {
+        fn new() -> Self {
+            use std::sync::atomic::{AtomicU64, Ordering};
+            static NEXT_FIXTURE: AtomicU64 = AtomicU64::new(0);
+            // Windows' wall clock can return the same timestamp to parallel
+            // tests. Reserve a distinct directory before exposing the fixture;
+            // AlreadyExists also protects against a stale path after PID reuse.
+            loop {
+                let path = std::env::temp_dir().join(format!(
+                    "herps-ctm-sprites-{}-{}",
+                    std::process::id(),
+                    NEXT_FIXTURE.fetch_add(1, Ordering::Relaxed),
+                ));
+                match fs::create_dir(&path) {
+                    Ok(()) => return Self(path),
+                    Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => continue,
+                    Err(error) => panic!(
+                        "cannot create CTM sprite fixture {}: {error}",
+                        path.display()
+                    ),
+                }
+            }
+        }
+        fn png(&self, relative: &str, color: [u8; 4]) {
+            let path = self.0.join(relative);
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            let mut encoder = png::Encoder::new(File::create(path).unwrap(), 16, 16);
+            encoder.set_color(png::ColorType::Rgba);
+            encoder.set_depth(png::BitDepth::Eight);
+            encoder
+                .write_header()
+                .unwrap()
+                .write_image_data(&color.repeat(256))
+                .unwrap();
+        }
+        fn text(&self, relative: &str, text: &str) {
+            let path = self.0.join(relative);
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            fs::write(path, text).unwrap();
+        }
+        fn emissive(&self) {
+            self.text(
+                "assets/minecraft/optifine/emissive.properties",
+                "suffix.emissive=_e\n",
+            );
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+    #[test]
+    fn ctm_resource_image_does_not_alias_normal_texture_identifier() {
+        let root = Fixture::new();
+        root.png("assets/test/optifine/ctm/a/0.png", [10, 20, 30, 255]);
+        root.png(
+            "assets/test/textures/optifine/ctm/a/0.png",
+            [40, 50, 60, 128],
+        );
+        let mut sprites = Sprites::default();
+        let ordinary = sprites.insert(&root.0, "test:optifine/ctm/a/0").unwrap();
+        let ctm = sprites
+            .insert_resource(&root.0, "test:optifine/ctm/a/0")
+            .unwrap();
+        assert_ne!(ordinary, ctm);
+        assert_eq!(
+            sprites
+                .insert_resource(&root.0, "test:optifine/ctm/a/0")
+                .unwrap(),
+            ctm
+        );
+        sprites.finish();
+        assert_eq!(
+            &sprites.pixels[ctm as usize * 1024..][..4],
+            &[10, 20, 30, 255]
+        );
+        assert_eq!(
+            &sprites.pixels[ordinary as usize * 1024..][..4],
+            &[40, 50, 60, 128]
+        );
+    }
+    #[test]
+    fn ctm_reload_reads_changed_pixels_and_rejects_unsafe_image_paths() {
+        let root = Fixture::new();
+        root.png("assets/test/optifine/ctm/a/0.png", [10, 20, 30, 255]);
+        fs::create_dir_all(root.0.join("assets/test/textures")).unwrap();
+        let mut before = Sprites::with_disk_cache(&root.0);
+        before
+            .insert_resource(&root.0, "test:optifine/ctm/a/0")
+            .unwrap();
+        before.save_disk_cache();
+        root.png("assets/test/optifine/ctm/a/0.png", [90, 80, 70, 255]);
+        let mut after = Sprites::with_disk_cache(&root.0);
+        let layer = after
+            .insert_resource(&root.0, "test:optifine/ctm/a/0")
+            .unwrap();
+        after.finish();
+        assert_eq!(
+            &after.pixels[layer as usize * 1024..][..4],
+            &[90, 80, 70, 255]
+        );
+        for invalid in [
+            "test:../secrets",
+            "test:optifine/ctm/../../secret",
+            "test:optifine/ctm//0",
+            "test:optifine/ctm/a\\0",
+            "../test:optifine/ctm/a/0",
+        ] {
+            assert!(
+                after.insert_resource(&root.0, invalid).is_err(),
+                "{invalid}"
+            );
+        }
+        assert!(
+            after
+                .insert_resource(&root.0, "test:optifine/ctm/a/missing")
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn emissive_siblings_do_not_alias_equal_base_images() {
+        let root = Fixture::new();
+        root.emissive();
+        for name in ["a", "b", "plain", "plain2"] {
+            root.png(
+                &format!("assets/test/textures/block/{name}.png"),
+                [20, 30, 40, 255],
+            );
+        }
+        root.png("assets/test/textures/block/a_e.png", [255, 0, 0, 255]);
+        root.png("assets/test/textures/block/a_e_e.png", [0, 0, 255, 255]);
+        root.png("assets/test/textures/block/b_e.png", [0, 255, 0, 128]);
+        let mut sprites = Sprites::default();
+        let a = sprites.insert(&root.0, "test:block/a").unwrap();
+        let b = sprites.insert(&root.0, "test:block/b").unwrap();
+        let plain = sprites.insert(&root.0, "test:block/plain").unwrap();
+        let plain2 = sprites.insert(&root.0, "test:block/plain2").unwrap();
+        assert_ne!(a, b);
+        assert_ne!(a, plain);
+        assert_ne!(b, plain);
+        assert_eq!(plain, plain2);
+        assert_eq!(sprites.emissive_layers.len(), 2);
+        let ae = sprites.emissive_layers[&a];
+        let be = sprites.emissive_layers[&b];
+        assert_ne!(ae, be);
+        assert!(!sprites.translucent[ae as usize]);
+        assert!(sprites.translucent[be as usize]);
+        assert_eq!(sprites.insert(&root.0, "test:block/a_e").unwrap(), ae);
+        assert!(!sprites.emissive_layers.contains_key(&ae));
+        sprites.finish();
+        let pixel = |layer| &sprites.pixels[layer as usize * 1024..][..4];
+        assert_eq!(pixel(a), &[20, 30, 40, 255]);
+        assert_eq!(pixel(ae), &[255, 0, 0, 255]);
+        assert_eq!(pixel(be), &[0, 255, 0, 128]);
+    }
