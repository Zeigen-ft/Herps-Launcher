+    /// Load a CTM image from `assets/<namespace>/optifine/ctm/`, rather than
+    /// `textures/`. Resource keys are separate from normal sprite identifiers.
+    /// These images deliberately bypass the disk cache: its fingerprint only
+    /// covers `textures/`, so caching them there could retain stale CTM pixels.
+    pub fn insert_resource(&mut self, root: &Path, name: &str) -> Result<u32> {
+        let (namespace, relative) = name.split_once(':').ok_or("invalid CTM image identifier")?;
+        if namespace.is_empty()
+            || !namespace
+                .bytes()
+                .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || b"_.-".contains(&c))
+            || !relative.starts_with("optifine/ctm/")
+            || relative
+                .split('/')
+                .any(|part| part.is_empty() || part == "." || part == "..")
+            || !relative
+                .bytes()
+                .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || b"_./-".contains(&c))
+        {
+            return Err("unsafe CTM image identifier".into());
+        }
+        let key = format!("@resource:{name}");
+        if let Some(&layer) = self.layers.get(&key) {
+            return Ok(layer);
+        }
+        let path = root.join(format!("assets/{namespace}/{relative}.png"));
+        let decoded = Self::decode_path(&path, name)?;
+        self.register(&key, decoded)
+    }
