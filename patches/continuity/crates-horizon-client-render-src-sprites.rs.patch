+    #[test]
+    fn emissive_overlay_animation_is_registered_independently_of_the_base() {
+        let root = Fixture::new();
+        root.emissive();
+        root.png("assets/test/textures/block/a.png", [50, 60, 70, 255]);
+        let path = root.0.join("assets/test/textures/block/a_e.png");
+        let mut encoder = png::Encoder::new(File::create(&path).unwrap(), 16, 32);
+        encoder.set_color(png::ColorType::Rgba);
+        encoder.set_depth(png::BitDepth::Eight);
+        encoder
+            .write_header()
+            .unwrap()
+            .write_image_data(
+                &[[200, 0, 0, 255].repeat(256), [0, 200, 0, 255].repeat(256)].concat(),
+            )
+            .unwrap();
+        root.text(
+            "assets/test/textures/block/a_e.png.mcmeta",
+            r#"{"animation":{"frametime":2,"frames":[1,0]}}"#,
+        );
+        let mut sprites = Sprites::default();
+        let base = sprites.insert(&root.0, "test:block/a").unwrap();
+        let overlay = sprites.emissive_layers[&base];
+        assert_eq!(sprites.animations.len(), 1);
+        assert_eq!(sprites.animations[0].layer, overlay);
+        assert_eq!(sprites.animations[0].frame(0), 1);
+        assert_eq!(sprites.animations[0].frame(2), 0);
+        sprites.finish();
+        assert_eq!(
+            &sprites.pixels[base as usize * 1024..][..4],
+            &[50, 60, 70, 255]
+        );
+        assert_eq!(
+            &sprites.pixels[overlay as usize * 1024..][..4],
+            &[0, 200, 0, 255]
+        );
+        root.text("assets/test/textures/block/a_e.png.mcmeta", "invalid JSON");
+        let mut invalid = Sprites::default();
+        let layer = invalid.insert(&root.0, "test:block/a").unwrap();
+        assert!(invalid.emissive_layers.is_empty());
+        invalid.finish();
+        assert_eq!(
+            &invalid.pixels[layer as usize * 1024..][..4],
+            &[50, 60, 70, 255]
+        );
+    }
