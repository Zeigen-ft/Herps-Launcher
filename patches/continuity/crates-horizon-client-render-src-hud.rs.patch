+    #[test]
+    fn emissive_item_atlas_alias_keeps_physical_texture_animation_and_reloads() {
+        let root =
+            std::env::temp_dir().join(format!("herps-atlas-emissive-alias-{}", std::process::id()));
+        let atlases = root.join("assets/minecraft/atlases");
+        let optifine = root.join("assets/minecraft/optifine");
+        let item = root.join("assets/gems/textures/item");
+        fs::create_dir_all(&atlases).unwrap();
+        fs::create_dir_all(&optifine).unwrap();
+        fs::create_dir_all(&item).unwrap();
+        fs::write(optifine.join("emissive.properties"), "suffix.emissive=_e\n").unwrap();
+        fs::write(atlases.join("items.json"), r#"{"sources":[{"type":"single","resource":"gems:item/physical","sprite":"gems:item/alias"}]}"#).unwrap();
+        write_strip(
+            &item.join("physical.png"),
+            16,
+            16,
+            &[[64, 64, 64, 255]],
+            None,
+        );
+        write_strip(
+            &item.join("physical_e.png"),
+            16,
+            32,
+            &[[255, 0, 0, 128], [0, 0, 255, 128]],
+            Some(r#"{"animation":{"frames":[1,0],"frametime":2}}"#),
+        );
+        let atlas = HudAtlas::build(&root).unwrap();
+        assert!(atlas.sprites.contains_key("gems:item/alias"));
+        let rect = atlas.sprites["gems:item/alias_e"];
+        assert_eq!(texel_at(&atlas, rect, 0, 0), [0, 0, 255, 128]);
+        assert!(atlas.translucent.contains("gems:item/alias_e"));
+        let (_, animation) = atlas
+            .sprite_animations
+            .iter()
+            .find(|(r, _)| r.u0 == rect.u0 && r.v0 == rect.v0)
+            .expect("the emissive alias uses its physical source animation");
+        assert_eq!(animation.frame(0), 1);
+        assert_eq!(animation.frame_count(), 2);
+        fs::remove_file(optifine.join("emissive.properties")).unwrap();
+        let reloaded = HudAtlas::build(&root).unwrap();
+        assert!(reloaded.sprites.contains_key("gems:item/alias"));
+        assert!(!reloaded.sprites.contains_key("gems:item/alias_e"));
+        fs::remove_dir_all(&root).unwrap();
+    }
