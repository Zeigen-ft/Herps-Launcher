+    #[test]
+    fn emissive_item_overlays_follow_their_base_in_the_same_material() {
+        let vertices: Vec<_> = [
+            0,
+            EMISSIVE_ITEM_OVERLAY,
+            TRANSLUCENT_ITEM_OVERLAY,
+            TRANSLUCENT_EMISSIVE_ITEM_OVERLAY,
+            0,
+            EMISSIVE_ITEM_OVERLAY,
+        ]
+        .into_iter()
+        .enumerate()
+        .flat_map(|(id, layer)| {
+            [Vertex {
+                pos: [id as f32, 0.0, 0.0],
+                uv: [0.0; 2],
+                layer,
+                color: 0xffff_ffff,
+                light: 0,
+                normal: [0; 4],
+                glint_uv: [0.0; 2],
+            }; 4]
+        })
+        .collect();
+        let mut batch = EntityBatch::default();
+        for oit in [false, true] {
+            assert_eq!(
+                batch.update(&vertices, &[], &[], &[], oit),
+                [4, 0, 0, 0, 0, 0, 0, 0, 2, 0]
+            );
+            let order: Vec<_> = batch
+                .combined
+                .as_chunks::<4>()
+                .0
+                .iter()
+                .map(|q| q[0].pos[0] as u32)
+                .collect();
+            assert_eq!(order, [0, 1, 4, 5, 2, 3]);
+        }
+    }
 
