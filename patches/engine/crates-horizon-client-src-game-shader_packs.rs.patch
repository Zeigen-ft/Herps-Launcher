 impl Game<'_> {
+    /// Starts the item's own draw while preserving its parent entity/block kind.
+    /// An empty name restores the non-item part of that entity.
+    pub(super) fn mark_rendered_item(&self, start: usize, name: &str) {
+        if self.pack_ids.is_none() {
+            return;
+        }
+        let item_id = self.rendered_item_id_for_pack(name);
+        let mut spans = self.entity_spans.borrow_mut();
+        let Some(last) = spans.last().copied() else {
+            return;
+        };
+        if last.item_id == item_id {
+            return;
+        }
+        let span = EntitySpan {
+            start: start as u32,
+            item_id,
+            ..last
+        };
+        match spans.last_mut() {
+            Some(last) if last.start == span.start => *last = span,
+            _ => spans.push(span),
+        }
+    }
