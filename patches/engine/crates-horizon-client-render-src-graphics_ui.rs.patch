+
+    #[test]
+    fn explored_lod_controls_are_opt_in_and_do_not_change_near_or_legacy_distance() {
+        let mut s = Settings::default();
+        let near = s.render_distance;
+        let legacy = s.horizon.lod_distance;
+        assert_eq!(Item::Horizon(H::VisitedLod).label(&s).plain(), "Explored Terrain LOD: Off");
+        H::VisitedLod.cycle(&mut s, false);
+        assert!(s.horizon.visited_lod);
+        for (control, low, high) in [
+            (H::VisitedLodRadius, 16, 256),
+            (H::LodMemory, 8, 512),
+            (H::LodDisk, 16, 4096),
+            (H::LodWorkers, 1, 4),
+        ] {
+            control.set_slider(&mut s, 0.0);
+            assert_eq!(control.slider(&s), Some(0.0));
+            assert!(control.label(&s).plain().contains(&low.to_string()));
+            control.set_slider(&mut s, 1.0);
+            assert_eq!(control.slider(&s), Some(1.0));
+            assert!(control.label(&s).plain().contains(&high.to_string()));
+        }
+        assert_eq!(s.render_distance, near);
+        assert_eq!(s.horizon.lod_distance, legacy);
+    }
+
+}
