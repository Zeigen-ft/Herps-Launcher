+
+    #[test]
+    fn explored_lod_defaults_and_bounds_preserve_legacy_settings() {
+        let defaults = Graphics::default();
+        assert!(!defaults.visited_lod);
+        assert_eq!(defaults.visited_lod_radius, 64);
+        assert_eq!(defaults.lod_memory_mib, 64);
+        assert_eq!(defaults.lod_disk_mib, 512);
+        assert_eq!(defaults.lod_workers, 1);
+        assert_eq!(defaults.lod_distance, 0);
+        let low = Graphics::parse("visitedLod:true\nvisitedLodRadius:1\nlodMemoryMiB:0\nlodDiskMiB:0\nlodWorkers:0\n");
+        assert!(low.visited_lod);
+        assert_eq!((low.visited_lod_radius, low.lod_memory_mib, low.lod_disk_mib, low.lod_workers), (16, 8, 16, 1));
+        let high = Graphics::parse("visitedLodRadius:999999\nlodMemoryMiB:999999\nlodDiskMiB:999999\nlodWorkers:999999\n");
+        assert_eq!((high.visited_lod_radius, high.lod_memory_mib, high.lod_disk_mib, high.lod_workers), (256, 512, 4096, 4));
+        let invalid = Graphics::parse("visitedLod:yes\nvisitedLodRadius:-1\nlodMemoryMiB:bad\nlodDiskMiB:-1\nlodWorkers:bad\n");
+        assert_eq!(invalid, defaults);
+        assert_eq!(Graphics::parse(&high.serialize()), high);
+    }
+
+}
