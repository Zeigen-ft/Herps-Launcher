+    #[test]
+    fn desktop_yields_on_small_bursts_with_auto_or_manual_limits() {
+        for (count, bytes) in [(0, 0), (4, 2048)] {
+            let mut remaining = 8;
+            for expected in [6, 4, 2, 0] {
+                let mut budget =
+                    UploadBudget::with_wait(count, bytes, false, Duration::from_millis(32));
+                let mut elapsed = Duration::ZERO;
+                while remaining > 0 && budget.allows(128, elapsed) {
+                    budget.record(128);
+                    elapsed += Duration::from_millis(1);
+                    remaining -= 1;
+                }
+                assert_eq!(remaining, expected);
+            }
+        }
+    }
+
+    #[test]
+    fn oversized_desktop_section_still_makes_progress() {
+        let mut budget = UploadBudget::new(0, 1024, false);
+        assert!(budget.allows(8192, Duration::from_millis(3)));
+        budget.record(8192);
+        assert!(!budget.allows(1, Duration::ZERO));
