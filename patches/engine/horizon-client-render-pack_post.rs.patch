+/// Decode only bounded PNG images, preserving their rows and their actual
+/// (possibly non-square) dimensions. Limits apply before allocating pixels.
+fn custom_png(bytes: &[u8], max_side: u32) -> Result<(u32, u32, Vec<u8>), String> {
+    const MAX_PIXELS_BYTES: usize = 64 * 1024 * 1024;
+    let mut decoder = png::Decoder::new(std::io::Cursor::new(bytes));
+    decoder.set_limits(png::Limits {
+        bytes: MAX_PIXELS_BYTES,
+    });
+    decoder.set_transformations(png::Transformations::EXPAND | png::Transformations::STRIP_16);
+    let mut reader = decoder.read_info().map_err(|e| e.to_string())?;
+    let (width, height) = (reader.info().width, reader.info().height);
+    let pixels = u64::from(width) * u64::from(height);
+    if width == 0
+        || height == 0
+        || width > max_side
+        || height > max_side
+        || pixels > (MAX_PIXELS_BYTES / 4) as u64
+    {
+        return Err("custom texture exceeds the device or decoded-image size limit".into());
+    }
+    let size = reader
+        .output_buffer_size()
+        .ok_or("custom texture is too large")?;
+    if size > MAX_PIXELS_BYTES {
+        return Err("custom texture decoded-image size limit".into());
+    }
+    let mut data = vec![0; size];
+    let info = reader.next_frame(&mut data).map_err(|e| e.to_string())?;
+    let channels = info.color_type.samples();
+    let mut rgba = Vec::with_capacity(pixels as usize * 4);
+    for p in data[..info.buffer_size()].chunks_exact(channels) {
+        rgba.extend_from_slice(&match channels {
+            4 => [p[0], p[1], p[2], p[3]],
+            3 => [p[0], p[1], p[2], 255],
+            2 => [p[0], p[0], p[0], p[1]],
+            1 => [p[0], p[0], p[0], 255],
+            _ => return Err("unsupported PNG colour type".into()),
+        });
+    }
+    Ok((width, height, rgba))
+}
+
+fn custom_images(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    declarations: Vec<horizon_shaders::CustomTexture>,
+    notes: &mut Vec<String>,
+) -> (Vec<horizon_shaders::CustomTexture>, Vec<wgpu::TextureView>) {
+    let (mut accepted, mut views) = (Vec::new(), Vec::new());
+    let mut loaded = HashMap::<String, wgpu::TextureView>::new();
+    let mut decoded_bytes = 0usize;
+    for mut declaration in declarations {
+        let view = if let Some(view) = loaded.get(&declaration.path) {
+            view.clone()
+        } else {
+            let result = custom_png(&declaration.data, device.limits().max_texture_dimension_2d);
+            let (width, height, pixels) = match result {
+                Ok(image) if decoded_bytes + image.2.len() <= 64 * 1024 * 1024 => image,
+                Ok(_) => {
+                    notes.push("custom texture aggregate decoded-image size limit".into());
+                    continue;
+                }
+                Err(error) => {
+                    notes.push(format!("custom texture {}: {error}", declaration.path));
+                    continue;
+                }
+            };
+            decoded_bytes += pixels.len();
+            let view = texture_rgba(device, queue, &declaration.path, width, height, &pixels);
+            loaded.insert(declaration.path.clone(), view.clone());
+            notes.push(format!(
+                "custom texture {} loaded ({width}x{height})",
+                declaration.path
+            ));
+            view
+        };
+        declaration.data = Vec::new();
+        accepted.push(declaration);
+        views.push(view);
+    }
+    (accepted, views)
+}
+
+fn custom_slot(
+    group: Group,
+    sampler: &str,
+    textures: &[horizon_shaders::CustomTexture],
+) -> Option<usize> {
+    let stage = match group {
+        Group::Prepare => "prepare",
+        Group::Deferred => "deferred",
+        Group::Composite => "composite",
+        Group::Final => "final",
+        Group::Gbuffers | Group::Translucent => "gbuffers",
+        Group::Shadow => "shadow",
+        Group::ShadowComp => "shadowcomp",
+    };
+    textures
+        .iter()
+        .position(|t| t.stage == stage && t.matches(stage, sampler))
+        .or_else(|| {
+            textures
+                .iter()
+                .position(|t| t.stage == "*" && t.matches(stage, sampler))
+        })
 }
 
