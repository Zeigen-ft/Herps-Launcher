+/// Herspers' camera split convention: floor in f64, then subtract before reducing
+/// the fractional part to f32. Fractions stay in [0, 1), including west/below spawn.
+/// This is an explicit Herspers convention, not a claim of Iris implementation parity.
+fn split_camera_position(position: DVec3) -> ([i32; 3], [f32; 3]) {
+    let whole = position.floor();
+    (
+        whole.as_ivec3().to_array(),
+        (position - whole).as_vec3().to_array(),
+    )
+}
+
+/// The first rendered bolt in player space: camera-relative, world-aligned axes.
+/// Subtract before casting to f32 so nearby strikes retain precision far from spawn.
+/// The documented w flag is 1 for a bolt and 0 when there is none.
+fn lightning_position(camera: DVec3, position: Option<[f64; 3]>) -> [f32; 4] {
+    position.map_or([0.0; 4], |at| {
+        let offset = (DVec3::from_array(at) - camera).as_vec3();
+        [offset.x, offset.y, offset.z, 1.0]
+    })
+}
+
+/// Herspers' velocity convention: actual feet displacement over the movement tick,
+/// in blocks per second. Collision-limited motion, passengers and vertical motion
+/// are included; a zero/invalid interval has no measurable speed.
+pub fn player_displacement_speed(previous: DVec3, current: DVec3, tick_seconds: f64) -> f32 {
+    if tick_seconds.is_finite() && tick_seconds > 0.0 {
+        (current.distance(previous) / tick_seconds) as f32
+    } else {
+        0.0
     }
 }
 
