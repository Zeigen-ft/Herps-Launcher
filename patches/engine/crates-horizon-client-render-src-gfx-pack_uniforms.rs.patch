+            for axis in 0..3 {
+                assert!((0.0..1.0).contains(&fraction[axis]), "{position:?}");
+                let rebuilt = f64::from(whole[axis]) + f64::from(fraction[axis]);
+                assert!((rebuilt - position[axis]).abs() < 1e-6, "{position:?}");
