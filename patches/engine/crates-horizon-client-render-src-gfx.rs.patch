+    /// Reconfigure only the presentation surface and transient frame buffers.
+    /// The active world, network session, terrain meshes and resource packs stay live.
+    pub fn refresh_window_output(&mut self) {
+        let size = self.window.inner_size();
+        if self.surface.is_none()
+            || self.window.is_minimized() == Some(true)
+            || !drawable_size(
+                size.width,
+                size.height,
+                self.device.limits().max_texture_dimension_2d,
+            )
+        {
+            return;
+        }
+        self.world_post.invalidate_output();
+        self.resize(size.width, size.height);
+        self.window.request_redraw();
+        log::info!(
+            "Horizon: refreshed window output at {} x {}",
+            size.width,
+            size.height
+        );
+    }
