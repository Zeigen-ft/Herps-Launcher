+/// Optional real-pack validation: the caller supplies their original archives.
+/// Unlike the legacy metadata harness, every selected program must become a GPU
+/// pipeline using the game's real vertex inputs and binding layouts.
+#[test]
+#[ignore = "requires HORIZON_TEST_SHADER_PACKS and software/hardware Vulkan"]
+fn real_shader_pack_pipelines_use_the_game_geometry() {
+    use super::super::{pack_atlas::PackAtlas, pack_entities, pack_hand, pack_sky, pack_weather};
+    let folder = std::env::var_os("HORIZON_TEST_SHADER_PACKS")
+        .expect("set HORIZON_TEST_SHADER_PACKS to original shader archives");
+    let found = horizon_shaders::discover(std::path::Path::new(&folder));
+    assert!(!found.is_empty(), "no shader packs were discovered");
+    let mut descriptor = wgpu::InstanceDescriptor::new_without_display_handle();
+    descriptor.backends = wgpu::Backends::VULKAN;
+    let instance = wgpu::Instance::new(descriptor);
+    let adapter = pollster::block_on(instance.request_adapter(&Default::default()))
+        .expect("this explicit real-pack test requires a Vulkan adapter");
+    let features = adapter.features()
+        & (wgpu::Features::TEXTURE_FORMAT_16BIT_NORM
+            | wgpu::Features::TEXTURE_ADAPTER_SPECIFIC_FORMAT_FEATURES
+            | wgpu::Features::RG11B10UFLOAT_RENDERABLE
+            | wgpu::Features::FLOAT32_BLENDABLE);
+    let (device, queue) = pollster::block_on(adapter.request_device(&wgpu::DeviceDescriptor {
+        required_features: features,
+        required_limits: adapter.limits(),
+        ..Default::default()
+    }))
+    .expect("Vulkan adapter must provide the real-pack device");
+    let source = device.create_texture(&wgpu::TextureDescriptor {
+        label: Some("Original empty block sprite array"),
+        size: wgpu::Extent3d {
+            width: 16,
+            height: 16,
+            depth_or_array_layers: 1,
+        },
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: wgpu::TextureFormat::Rgba8Unorm,
+        usage: wgpu::TextureUsages::TEXTURE_BINDING
+            | wgpu::TextureUsages::COPY_SRC
+            | wgpu::TextureUsages::COPY_DST,
+        view_formats: &[],
+    });
+    let mut encoder = device.create_command_encoder(&Default::default());
+    let atlas = PackAtlas::new(&device, &mut encoder, &[source], 1, 1, 16)
+        .expect("one sprite fits the block atlas");
+    queue.submit([encoder.finish()]);
+    let single = texture_rgba(&device, &queue, "Original white lightmap", 1, 1, &[255; 4]);
+    let clouds = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: Some("Actual cloud binding signature"),
+        entries: &[wgpu::BindGroupLayoutEntry {
+            binding: 0,
+            visibility: wgpu::ShaderStages::VERTEX,
+            ty: wgpu::BindingType::Buffer {
+                ty: wgpu::BufferBindingType::Uniform,
+                has_dynamic_offset: false,
+                min_binding_size: None,
+            },
+            count: None,
+        }],
+    });
+    let flat_table = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: Some("Actual flat-terrain binding signature"),
+        entries: &[0, 1].map(|binding| wgpu::BindGroupLayoutEntry {
+            binding,
+            visibility: wgpu::ShaderStages::VERTEX,
+            ty: wgpu::BindingType::Buffer {
+                ty: wgpu::BufferBindingType::Storage { read_only: true },
+                has_dynamic_offset: false,
+                min_binding_size: None,
+            },
+            count: None,
+        }),
+    });
+    let instance_attributes = wgpu::vertex_attr_array![5=>Float32x4];
+    let buffers = [
+        Some(wgpu::VertexBufferLayout {
+            array_stride: std::mem::size_of::<super::super::TerrainVertex>() as u64,
+            step_mode: wgpu::VertexStepMode::Vertex,
+            attributes: &super::super::TERRAIN_ATTRIBUTES,
+        }),
+        Some(wgpu::VertexBufferLayout {
+            array_stride: 16,
+            step_mode: wgpu::VertexStepMode::Instance,
+            attributes: &instance_attributes,
+        }),
+    ];
+    for entry in found {
+        assert!(
+            entry.problem.is_none(),
+            "{}: {:?}",
+            entry.name,
+            entry.problem
+        );
+        let pack = Pack::open(&entry.path).unwrap();
+        let macros = Macros::standard();
+        let properties = Properties::parse(
+            &pack.read_text("shaders.properties").unwrap_or_default(),
+            &macros,
+        );
+        for dimension in [0, -1, 1] {
+            for flat in [false, true] {
+                let inputs = GameInputs {
+                    terrain: Some(atlas.terrain_inputs(flat)),
+                    sky: Some(pack_sky::inputs()),
+                    celestial: Some(pack_sky::celestial_inputs()),
+                    entities: Some(pack_entities::inputs()),
+                    clouds: Some(pack_entities::cloud_inputs()),
+                    weather: Some(pack_weather::inputs()),
+                    hand: Some(pack_hand::inputs()),
+                };
+                let mut post = load_post(
+                    &pack,
+                    &horizon_shaders::dimension_folder(&pack, dimension),
+                    &properties,
+                    &macros,
+                    &inputs,
+                );
+                post.custom.set_biomes(ORIGINAL_BIOMES);
+                assert!(
+                    post.notes.is_empty(),
+                    "{} dimension{dimension} flat{flat}: {:?}",
+                    entry.name,
+                    post.notes
+                );
+                for program in post.programs.iter().chain(&post.shadow_comp).chain(
+                    [
+                        &post.terrain,
+                        &post.water,
+                        &post.sky,
+                        &post.sky_textured,
+                        &post.entities,
+                        &post.block,
+                        &post.entities_translucent,
+                        &post.particles,
+                        &post.clouds,
+                        &post.weather,
+                        &post.hand,
+                        &post.shadow,
+                        &post.shadow_water,
+                        &post.shadow_entities,
+                        &post.shadow_block,
+                    ]
+                    .into_iter()
+                    .filter_map(Option::as_ref),
+                ) {
+                    author_program_backend_writers(&entry.name, program);
+                }
+                let expected_post = post.programs.len();
+                assert!(expected_post > 0, "{}: no post programs loaded", entry.name);
+                let expected_terrain = post.terrain.is_some();
+                let expected_water = post.water.is_some();
+                let expected_shadow = post.shadow.is_some();
+                let expected_shadow_water = post.shadow_water.is_some();
+                let expected_shadow_comp = post.shadow_comp.len();
+                let suppress_clouds = post.clouds.as_ref().is_some_and(|p| {
+                    p.program.interface.outputs.is_empty() || p.buffers.is_empty()
+                });
+                let expected_clouds = post.clouds.is_some() && !suppress_clouds;
+                let expected_weather = post.weather.is_some();
+                let expected_hand = post.hand.is_some();
+                let expected_sky = post.sky.is_some();
+                let expected_celestial = post.sky_textured.is_some();
+                let expected_entities = [
+                    post.entities.is_some(),
+                    post.block.is_some(),
+                    post.entities_translucent.is_some(),
+                    post.particles.is_some(),
+                ];
+                let expected_shadow_entities =
+                    [post.shadow_entities.is_some(), post.shadow_block.is_some()];
+                let renderer = PackPost::new(
+                    &device,
+                    &queue,
+                    post,
+                    wgpu::TextureFormat::Rgba8Unorm,
+                    World {
+                        atlas: Some((atlas.view.clone(), atlas.size())),
+                        lightmap: single.clone(),
+                        terrain: Some(Geometry {
+                            buffers: if flat { &buffers[..1] } else { &buffers },
+                            table: flat.then_some(&flat_table),
+                            depth_write: true,
+                            atlas: None,
+                            ids: None,
+                            cull: true,
+                        }),
+                        block_ids: &[-1, -1],
+                        celestial: Some(single.clone()),
+                        clouds: Some(&clouds),
+                        weather: true,
+                        hand: true,
+                    },
+                );
+                let context = format!(
+                    "{} dimension{dimension} flat{flat}: {:?}",
+                    entry.name, renderer.notes
+                );
+                if suppress_clouds {
+                    assert!(
+                        renderer.hides_clouds && renderer.clouds.is_none(),
+                        "{context}"
+                    );
+                }
+                assert!(
+                    !renderer.notes.iter().any(|note| (note.contains("skipped")
+                        && !(suppress_clouds
+                            && note == "gbuffers_clouds: writes no buffer; skipped"))
+                        || note.contains("not provided yet")
+                        || note.contains("zero for now:")
+                        || note.contains("names no biome")
+                        || note.contains("failed")),
+                    "{context}"
+                );
+                assert_eq!(renderer.passes.len(), expected_post, "{context}");
+                assert_eq!(renderer.terrain.is_some(), expected_terrain, "{context}");
+                assert_eq!(renderer.water.is_some(), expected_water, "{context}");
+                assert_eq!(
+                    renderer.shadow_terrain.is_some(),
+                    expected_shadow,
+                    "{context}"
+                );
+                assert_eq!(
+                    renderer.shadow_water.is_some(),
+                    expected_shadow_water,
+                    "{context}"
+                );
+                assert_eq!(
+                    renderer.shadow_comp.len(),
+                    expected_shadow_comp,
+                    "{context}"
+                );
+                assert_eq!(renderer.clouds.is_some(), expected_clouds, "{context}");
+                assert_eq!(renderer.weather.is_some(), expected_weather, "{context}");
+                assert_eq!(renderer.hand.is_some(), expected_hand, "{context}");
+                assert_eq!(
+                    renderer.sky.as_ref().is_some_and(|sky| sky.basic.is_some()),
+                    expected_sky,
+                    "{context}"
+                );
+                assert_eq!(
+                    renderer
+                        .sky
+                        .as_ref()
+                        .is_some_and(|sky| sky.textured.is_some()),
+                    expected_celestial,
+                    "{context}"
+                );
+                for i in 0..4 {
+                    assert_eq!(
+                        renderer
+                            .entities
+                            .as_ref()
+                            .is_some_and(|entities| entities.passes[i].is_some()),
+                        expected_entities[i],
+                        "{context}"
+                    );
+                }
+                for i in 0..2 {
+                    assert_eq!(
+                        renderer
+                            .entities
+                            .as_ref()
+                            .is_some_and(|entities| entities.shadow[i].is_some()),
+                        expected_shadow_entities[i],
+                        "{context}"
+                    );
+                }
+                println!(
+                    "{} dimension{dimension} flat{flat}: {expected_post} post pipelines, terrain/shadow/sky/entities/cloud/weather/hand requirements preserved; {} loading notes",
+                    entry.name,
+                    renderer.notes.len()
+                );
+                device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+            }
+        }
+    }
+}
