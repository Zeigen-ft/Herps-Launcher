+// SPDX-License-Identifier: MIT
+//! Original generated-image fixtures for custom shader-pack texture bindings.
+use super::*;
+use horizon_shaders::{CustomTexture, GameInputs, Macros, Pack, Properties, load_post};
+
+// The original scene is plains; provide the named biome registry just as the
+// real game does, so custom expressions never rely on missing-biome fallbacks.
+const ORIGINAL_BIOMES: &[&str] = &[
+    "minecraft:plains",
+    "minecraft:nether_wastes",
+    "minecraft:crimson_forest",
+    "minecraft:warped_forest",
+    "minecraft:basalt_deltas",
+    "minecraft:soul_sand_valley",
+    "minecraft:pale_garden",
+];
+
+fn png_bytes(width: u32, height: u32, color: png::ColorType, pixels: &[u8]) -> Vec<u8> {
+    let mut bytes = Vec::new();
+    {
+        let mut encoder = png::Encoder::new(&mut bytes, width, height);
+        encoder.set_color(color);
+        encoder.set_depth(png::BitDepth::Eight);
+        let mut writer = encoder.write_header().unwrap();
+        writer.write_image_data(pixels).unwrap();
+    }
+    bytes
+}
+
+fn declaration(stage: &str, sampler: &str) -> CustomTexture {
+    CustomTexture {
+        stage: stage.into(),
+        sampler: sampler.into(),
+        path: "original.png".into(),
+        data: Vec::new(),
+    }
+}
+
+#[test]
+fn custom_png_preserves_non_square_rgba_rows() {
+    let pixels = [17, 90, 203, 255, 210, 40, 70, 128];
+    let encoded = png_bytes(2, 1, png::ColorType::Rgba, &pixels);
+    let (width, height, decoded) = custom_png(&encoded, 4096).unwrap();
+    assert_eq!((width, height), (2, 1));
+    assert_eq!(decoded, pixels);
+}
+
+#[test]
+fn custom_png_expands_grayscale_alpha_without_losing_alpha() {
+    let encoded = png_bytes(2, 1, png::ColorType::GrayscaleAlpha, &[32, 255, 128, 17]);
+    let (width, height, decoded) = custom_png(&encoded, 4096).unwrap();
+    assert_eq!((width, height), (2, 1));
+    assert_eq!(decoded, [32, 32, 32, 255, 128, 128, 128, 17]);
+}
+
+#[test]
+fn custom_png_refuses_oversized_and_malformed_inputs() {
+    let encoded = png_bytes(2, 1, png::ColorType::Rgba, &[0; 8]);
+    assert!(custom_png(&encoded, 1).is_err());
+    assert!(custom_png(b"not an image", 4096).is_err());
+    assert!(custom_png(&encoded[..24], 4096).is_err());
+}
+
+#[test]
+fn custom_texture_resolver_honors_stage_aliases_and_noise_precedence() {
+    let textures = vec![
+        declaration("*", "noisetex"),
+        declaration("gbuffers", "gaux4"),
+        declaration("deferred", "colortex3"),
+        declaration("gbuffers", "noisetex"),
+    ];
+    assert_eq!(
+        custom_slot(Group::Gbuffers, "colortex7", &textures),
+        Some(1)
+    );
+    assert_eq!(custom_slot(Group::Translucent, "gaux4", &textures), Some(1));
+    assert_eq!(
+        custom_slot(Group::Deferred, "composite", &textures),
+        Some(2)
+    );
+    assert_eq!(custom_slot(Group::Composite, "colortex3", &textures), None);
+    assert_eq!(custom_slot(Group::Gbuffers, "noisetex", &textures), Some(3));
+    for group in [
+        Group::Prepare,
+        Group::Deferred,
+        Group::Final,
+        Group::Shadow,
+        Group::ShadowComp,
+    ] {
+        assert_eq!(custom_slot(group, "noisetex", &textures), Some(0));
+    }
+}
