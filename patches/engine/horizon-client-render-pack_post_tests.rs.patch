+/// Exercises actual PNG upload, program translation, custom sampler resolution,
+/// pipeline creation, binding, drawing, and GPU readback. No third-party pack.
+#[test]
+#[ignore = "requires software/hardware Vulkan"]
+fn custom_texture_is_sampled_by_a_real_deferred_gpu_pass() {
+    let mut descriptor = wgpu::InstanceDescriptor::new_without_display_handle();
+    descriptor.backends = wgpu::Backends::VULKAN;
+    let instance = wgpu::Instance::new(descriptor);
+    let adapter = pollster::block_on(instance.request_adapter(&Default::default()))
+        .expect("this explicit GPU test requires a Vulkan adapter");
+    let (device, queue) = pollster::block_on(adapter.request_device(&Default::default()))
+        .expect("Vulkan adapter must provide a device");
+    let scratch = Scratch::new();
+    let shaders = scratch.0.join("shaders");
+    let expected = [17u8, 90, 203, 255];
+    let png = png_bytes(
+        2,
+        1,
+        png::ColorType::Rgba,
+        &[17, 90, 203, 255, 210, 40, 70, 255],
+    );
+    std::fs::write(shaders.join("original.png"), &png).unwrap();
+    std::fs::write(
+        shaders.join("deferred.vsh"),
+        "#version 120\nvoid main() { gl_Position = ftransform(); }\n",
+    )
+    .unwrap();
+    std::fs::write(shaders.join("deferred.fsh"),
+        "#version 120\nuniform sampler2D colortex3;\nvoid main() { gl_FragColor = texture2D(colortex3, vec2(0.25, 0.5)); }\n").unwrap();
+    let metadata = "texture.noise=original.png\ntexture.deferred.colortex3=original.png\n";
+    let pack = Pack::open(&scratch.0).unwrap();
+    let properties = Properties::parse(metadata, &Macros::standard());
+    let mut post = load_post(
+        &pack,
+        "",
+        &properties,
+        &Macros::standard(),
+        &GameInputs::default(),
+    );
+    assert!(
+        post.notes.is_empty(),
+        "unexpected loader notes: {:?}",
+        post.notes
+    );
+    assert_eq!(post.programs.len(), 1);
+    let mut notes = Vec::new();
+    let (textures, views) = custom_images(
+        &device,
+        &queue,
+        std::mem::take(&mut post.textures),
+        &mut notes,
+    );
+    assert_eq!(textures.len(), 2, "{notes:?}");
+    assert_eq!(views.len(), 2);
+    assert!(textures.iter().all(|texture| texture.data.is_empty()));
+    assert_eq!(
+        notes.iter().filter(|note| note.contains("loaded")).count(),
+        1,
+        "the shared image should decode/upload once: {notes:?}"
+    );
+    let draw_uniforms = DrawUniforms::new(&device);
+    let pass = build_pass(
+        &device,
+        post.programs.remove(0),
+        &[wgpu::TextureFormat::Rgba8Unorm; BUFFERS],
+        None,
+        wgpu::TextureFormat::Rgba8Unorm,
+        &mut notes,
+        None,
+        &[],
+        &draw_uniforms.layout,
+        &textures,
+    )
+    .expect("the original deferred fixture must build");
+    assert!(
+        !notes
+            .iter()
+            .any(|note| note.contains("skipped") || note.contains("not provided")),
+        "{notes:?}"
+    );
+    assert_eq!(pass.samplers.len(), 1);
+    let binding = &pass.samplers[0];
+    let Source::Custom(slot) = binding.source else {
+        panic!("deferred colortex3 must use the custom image")
+    };
+    assert_eq!(slot, 1);
+    assert_eq!(
+        pass.reads, 0,
+        "the override must not depend on the colortex3 history buffer"
+    );
+    assert_eq!(pass.writes, [(0, 0)]);
+    let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+        mag_filter: wgpu::FilterMode::Linear,
+        min_filter: wgpu::FilterMode::Linear,
+        ..Default::default()
+    });
+    let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: Some("Original custom-image fixture"),
+        layout: &pass.layout,
+        entries: &[
+            wgpu::BindGroupEntry {
+                binding: 0,
+                resource: pass.ubo.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: binding.binding,
+                resource: wgpu::BindingResource::TextureView(&views[slot]),
+            },
+            wgpu::BindGroupEntry {
+                binding: binding.sampler,
+                resource: wgpu::BindingResource::Sampler(&sampler),
+            },
+        ],
+    });
+    let output = device.create_texture(&wgpu::TextureDescriptor {
+        label: Some("Original custom-image output"),
+        size: wgpu::Extent3d {
+            width: 1,
+            height: 1,
+            depth_or_array_layers: 1,
+        },
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: wgpu::TextureFormat::Rgba8Unorm,
+        usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+        view_formats: &[],
+    });
+    let view = output.create_view(&Default::default());
+    let readback = device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("Original custom-image readback"),
+        size: 256,
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    let mut encoder = device.create_command_encoder(&Default::default());
+    {
+        let mut render = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: Some("Original deferred fixture"),
+            color_attachments: &[attach(
+                &view,
+                wgpu::Operations {
+                    load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                    store: wgpu::StoreOp::Store,
+                },
+            )],
+            ..Default::default()
+        });
+        render.set_pipeline(&pass.pipeline);
+        render.set_bind_group(0, &group, &[]);
+        render.draw(0..6, 0..1);
+    }
+    encoder.copy_texture_to_buffer(
+        output.as_image_copy(),
+        wgpu::TexelCopyBufferInfo {
+            buffer: &readback,
+            layout: wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(256),
+                rows_per_image: None,
+            },
+        },
+        output.size(),
+    );
+    queue.submit([encoder.finish()]);
+    let (tx, rx) = std::sync::mpsc::sync_channel(1);
+    readback
+        .slice(..)
+        .map_async(wgpu::MapMode::Read, move |result| {
+            let _ = tx.send(result);
+        });
+    device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+    rx.recv().unwrap().unwrap();
+    let mapped = readback.slice(..).get_mapped_range().unwrap();
+    assert_eq!(&mapped[..4], &expected);
+
+    // An original outputless cloud program deliberately suppresses the vanilla
+    // clouds. It is not a failed shader pipeline and must not restore them.
+    std::fs::write(
+        shaders.join("gbuffers_clouds.vsh"),
+        "#version 120\nvoid main() { gl_Position = ftransform(); }\n",
+    )
+    .unwrap();
+    std::fs::write(
+        shaders.join("gbuffers_clouds.fsh"),
+        "#version 120\nvoid main() { discard; }\n",
+    )
+    .unwrap();
+    let pack = Pack::open(&scratch.0).unwrap();
+    let inputs = GameInputs {
+        clouds: Some(super::super::pack_entities::cloud_inputs()),
+        ..Default::default()
+    };
+    let post = load_post(&pack, "", &properties, &Macros::standard(), &inputs);
+    assert!(
+        post.clouds
+            .as_ref()
+            .is_some_and(|p| p.program.interface.outputs.is_empty())
+    );
+    let cloud_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: Some("Original cloud suppression signature"),
+        entries: &[wgpu::BindGroupLayoutEntry {
+            binding: 0,
+            visibility: wgpu::ShaderStages::VERTEX,
+            ty: wgpu::BindingType::Buffer {
+                ty: wgpu::BufferBindingType::Uniform,
+                has_dynamic_offset: false,
+                min_binding_size: None,
+            },
+            count: None,
+        }],
+    });
+    let white = texture_rgba(
+        &device,
+        &queue,
+        "Original cloud fixture lightmap",
+        1,
+        1,
+        &[255; 4],
+    );
+    let renderer = PackPost::new(
+        &device,
+        &queue,
+        post,
+        wgpu::TextureFormat::Rgba8Unorm,
+        World {
+            atlas: None,
+            lightmap: white,
+            terrain: None,
+            block_ids: &[],
+            celestial: None,
+            clouds: Some(&cloud_layout),
+            weather: false,
+            hand: false,
+        },
+    );
+    assert!(renderer.hides_clouds);
+    assert!(renderer.clouds.is_none());
+    assert!(
+        renderer
+            .notes
+            .iter()
+            .any(|note| note == "gbuffers_clouds: writes no buffer; skipped")
+    );
+    assert!(!renderer.notes.iter().any(
+        |note| note.contains("skipped") && note != "gbuffers_clouds: writes no buffer; skipped"
+    ));
+}
