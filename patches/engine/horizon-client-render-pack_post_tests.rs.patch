+        );
+    }
+    frame.camera.x += 0.0625;
+    uniforms.update(&frame, &frame.pack, [64, 48]);
+    let component = |name: &str| match uniforms.values[pack_uniforms::index(name).unwrap()] {
+        pack_uniforms::Value::F(values) => values[0],
+        _ => panic!("{name} must have a floating-point value"),
+    };
+    assert_eq!(component("previousCameraPositionFract"), 0.875);
+    assert_eq!(component("cameraPositionFract"), 0.9375);
