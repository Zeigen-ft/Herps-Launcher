+/// Source-generation checks complement Vulkan execution; they do not run the
+/// generated programs on Windows/Metal drivers or redistribute author shaders.
+fn author_program_backend_writers(pack: &str, program: &horizon_shaders::PostProgram) {
+    for module in [&program.program.vertex, &program.program.fragment] {
+        let info =
+            naga::valid::Validator::new(Default::default(), naga::valid::Capabilities::all())
+                .validate(module)
+                .unwrap_or_else(|error| panic!("{pack} {}: IR validation: {error}", program.name));
+        for entry in &module.entry_points {
+            let context = format!("{pack} {} {:?}", program.name, entry.stage);
+            let mut hlsl = String::new();
+            let hlsl_info = naga::back::hlsl::Writer::new(
+                &mut hlsl,
+                &naga::back::hlsl::Options::default(),
+                &naga::back::hlsl::PipelineOptions {
+                    entry_point: Some((entry.stage, entry.name.clone())),
+                },
+            )
+            .write(module, &info, None)
+            .unwrap_or_else(|error| panic!("{context}: HLSL writer: {error}"));
+            assert!(!hlsl.is_empty(), "{context}: empty HLSL source");
+            assert!(
+                hlsl_info.entry_point_names.iter().all(Result::is_ok),
+                "{context}: HLSL entry points: {:?}",
+                hlsl_info.entry_point_names
+            );
+            let (msl, msl_info) = naga::back::msl::write_string(
+                module,
+                &info,
+                &naga::back::msl::Options {
+                    lang_version: (2, 2),
+                    ..Default::default()
+                },
+                &naga::back::msl::PipelineOptions {
+                    entry_point: Some((entry.stage, entry.name.clone())),
+                    ..Default::default()
+                },
+            )
+            .unwrap_or_else(|error| panic!("{context}: MSL writer: {error}"));
+            assert!(!msl.is_empty(), "{context}: empty MSL source");
+            assert!(
+                msl_info.entry_point_names.iter().all(Result::is_ok),
+                "{context}: MSL entry points: {:?}",
+                msl_info.entry_point_names
+            );
+        }
+    }
+}
