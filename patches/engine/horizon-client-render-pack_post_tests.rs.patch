+    let instance = wgpu::Instance::new(descriptor);
+    let adapter = pollster::block_on(instance.request_adapter(&Default::default()))
+        .expect("this explicit GPU test requires a Vulkan adapter");
+    let (device, queue) = pollster::block_on(adapter.request_device(&Default::default())).unwrap();
+    let scratch = Scratch::new();
+    std::fs::write(
+        scratch.0.join("shaders/gbuffers_hand.vsh"),
+        "#version 120\nvoid main() { gl_Position = gl_Vertex; }\n",
+    )
+    .unwrap();
+    std::fs::write(
+        scratch.0.join("shaders/gbuffers_hand.fsh"),
+        "#version 120\nuniform int currentRenderedItemId;\nvoid main() {\n\
+         if (currentRenderedItemId == 101) gl_FragColor = vec4(1.0, 0.0, 0.0, 1.0);\n\
+         else if (currentRenderedItemId == 202) gl_FragColor = vec4(0.0, 1.0, 0.0, 1.0);\n\
+         else if (currentRenderedItemId == 0) gl_FragColor = vec4(0.0, 0.0, 1.0, 1.0);\n\
+         else gl_FragColor = vec4(1.0, 0.0, 1.0, 1.0);\n}\n",
+    )
+    .unwrap();
+    let post = load_post(
+        &Pack::open(&scratch.0).unwrap(),
+        "",
+        &Properties::default(),
+        &Macros::standard(),
+        &GameInputs {
+            hand: Some(super::super::pack_hand::inputs()),
+            ..Default::default()
+        },
+    );
+    assert!(post.notes.is_empty(), "{:?}", post.notes);
+    assert!(
+        post.hand
+            .as_ref()
+            .is_some_and(|hand| hand.program.interface.draw)
+    );
+    let lightmap = texture_rgba(
+        &device,
+        &queue,
+        "Original hand fixture lightmap",
+        1,
+        1,
+        &[255; 4],
+    );
+    let mut renderer = PackPost::new(
+        &device,
+        &queue,
+        post,
+        wgpu::TextureFormat::Rgba8Unorm,
+        World {
+            atlas: None,
+            lightmap,
+            terrain: None,
+            block_ids: &[],
+            celestial: None,
+            clouds: None,
+            weather: false,
+            hand: true,
+        },
+    );
+    assert!(renderer.hand.is_some(), "{:?}", renderer.notes);
+    let hand: Vec<super::super::Vertex> = [[-0.95, -0.4], [-0.3, 0.3], [0.4, 0.95]]
+        .into_iter()
+        .flat_map(|[left, right]| {
+            [
+                [left, -0.75, 0.0],
+                [right, -0.75, 0.0],
+                [right, 0.75, 0.0],
+                [left, 0.75, 0.0],
+            ]
+        })
+        .map(|pos| super::super::Vertex {
+            pos,
+            uv: [0.0; 2],
+            layer: 0,
+            color: u32::MAX,
+            light: 0xf0f0,
+            normal: [0, 0, 127, 0],
+            glint_uv: [0.0; 2],
+        })
+        .collect();
+    let size = [64, 48];
+    let hud = crate::hud::HudBatch::new(size);
+    let texture = |label, format, usage| {
+        device.create_texture(&wgpu::TextureDescriptor {
+            label: Some(label),
+            size: wgpu::Extent3d {
+                width: size[0],
+                height: size[1],
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format,
+            usage,
+            view_formats: &[],
+        })
+    };
+    let world = texture(
+        "Original hand fixture world",
+        wgpu::TextureFormat::Rgba8Unorm,
+        wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::RENDER_ATTACHMENT,
+    );
+    let depth = texture(
+        "Original hand fixture depth",
+        wgpu::TextureFormat::Depth32Float,
+        wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::RENDER_ATTACHMENT,
+    );
+    let output = texture(
+        "Original hand ID output",
+        wgpu::TextureFormat::Rgba8Unorm,
+        wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+    );
+    let world_view = world.create_view(&Default::default());
+    let depth_view = depth.create_view(&Default::default());
+    let output_view = output.create_view(&Default::default());
+    let readback = device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("Original hand ID readback"),
+        size: u64::from(256 * size[1]),
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    for [main, off] in [[101, 202], [202, 101]] {
+        let items = [
+            super::super::pack_draw::ItemSpan {
+                start: 4,
+                item_id: main,
+            },
+            super::super::pack_draw::ItemSpan {
+                start: 8,
+                item_id: off,
+            },
+        ];
+        let mut frame = original_world_frame(&hud);
+        frame.hand = &hand;
+        frame.hand_items = &items;
+        let mut encoder = device.create_command_encoder(&Default::default());
+        encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: Some("Original hand world clear"),
+            color_attachments: &[attach(
+                &world_view,
+                wgpu::Operations {
+                    load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                    store: wgpu::StoreOp::Store,
+                },
+            )],
+            depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                view: &depth_view,
+                depth_ops: Some(wgpu::Operations {
+                    load: wgpu::LoadOp::Clear(0.0),
+                    store: wgpu::StoreOp::Store,
+                }),
+                stencil_ops: None,
+            }),
+            ..Default::default()
+        });
+        renderer.run(
+            &device,
+            &queue,
+            &mut encoder,
+            &world_view,
+            &depth_view,
+            &output_view,
+            &frame,
+            &frame.pack,
+            size,
+            size,
+            &[],
+            &mut |_, _, _| {},
+        );
+        encoder.copy_texture_to_buffer(
+            output.as_image_copy(),
+            wgpu::TexelCopyBufferInfo {
+                buffer: &readback,
+                layout: wgpu::TexelCopyBufferLayout {
+                    offset: 0,
+                    bytes_per_row: Some(256),
+                    rows_per_image: None,
+                },
+            },
+            output.size(),
+        );
+        queue.submit([encoder.finish()]);
+        let (tx, rx) = std::sync::mpsc::sync_channel(1);
+        readback
+            .slice(..)
+            .map_async(wgpu::MapMode::Read, move |result| {
+                let _ = tx.send(result);
+            });
+        device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+        rx.recv().unwrap().unwrap();
+        let pixels = readback.slice(..).get_mapped_range().unwrap();
+        let color = |id| match id {
+            0 => [0, 0, 255, 255],
+            101 => [255, 0, 0, 255],
+            202 => [0, 255, 0, 255],
+            _ => unreachable!(),
+        };
+        for (x, item) in [(10usize, 0), (32, main), (53, off)] {
+            let offset = 24 * 256 + x * 4;
+            assert_eq!(
+                &pixels[offset..offset + 4],
+                &color(item),
+                "hand region x{x} must use item ID{item}; main{main} off{off}"
+            );
+        }
+        drop(pixels);
+        readback.unmap();
+    }
+}
