+#[test]
+fn frame_history_retains_sub_block_motion_and_has_no_current_object() {
+    let hud = crate::hud::HudBatch::new([64, 48]);
+    let mut frame = original_world_frame(&hud);
+    frame.camera = glam::DVec3::new(29_999_999.875, 64.0, -0.125);
+    let mut uniforms = FrameUniforms::default();
+    uniforms.update(&frame, &frame.pack, [64, 48]);
+    for (name, ty) in [
+        ("entityId", "int"),
+        ("blockEntityId", "int"),
+        ("currentRenderedItemId", "int"),
+        ("entityColor", "vec4"),
+    ] {
+        let value = uniforms.values[pack_uniforms::index(name).unwrap()];
+        let mut bytes = [0u8; 16];
+        value.write(ty, &mut bytes, 0);
+        assert_eq!(
+            bytes, [0; 16],
