+    let found = horizon_shaders::discover(std::path::Path::new(&folder));
+    assert!(!found.is_empty(), "no author shader archives found");
+    let mut descriptor = wgpu::InstanceDescriptor::new_without_display_handle();
+    descriptor.backends = wgpu::Backends::VULKAN;
+    let instance = wgpu::Instance::new(descriptor);
+    let adapter = pollster::block_on(instance.request_adapter(&Default::default()))
+        .expect("this explicit GPU test requires a Vulkan adapter");
+    let features = adapter.features()
+        & (wgpu::Features::TEXTURE_FORMAT_16BIT_NORM
+            | wgpu::Features::TEXTURE_ADAPTER_SPECIFIC_FORMAT_FEATURES
+            | wgpu::Features::RG11B10UFLOAT_RENDERABLE
+            | wgpu::Features::FLOAT32_BLENDABLE);
+    let (device, queue) = pollster::block_on(adapter.request_device(&wgpu::DeviceDescriptor {
+        required_features: features,
+        required_limits: adapter.limits(),
+        ..Default::default()
+    }))
+    .unwrap();
+    let original_pixels: Vec<u8> = (0..256)
+        .flat_map(|pixel| {
+            if (pixel / 16 + pixel % 16) % 2 == 0 {
+                [200, 80, 35, 255]
+            } else {
+                [35, 180, 75, 255]
+            }
+        })
+        .collect();
+    let source = device.create_texture_with_data(
+        &queue,
+        &wgpu::TextureDescriptor {
+            label: Some("Original two-color terrain sprite"),
+            size: wgpu::Extent3d {
+                width: 16,
+                height: 16,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Rgba8Unorm,
+            usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_SRC,
+            view_formats: &[],
+        },
+        wgpu::util::TextureDataOrder::LayerMajor,
+        &original_pixels,
+    );
+    let mut encoder = device.create_command_encoder(&Default::default());
+    let atlas = PackAtlas::new(&device, &mut encoder, &[source], 1, 1, 16).unwrap();
+    queue.submit([encoder.finish()]);
+    let lightmap = texture_rgba(&device, &queue, "Original full lightmap", 1, 1, &[255; 4]);
+    let terrain_vertices = [
+        ([-4.0, -2.0, 3.0], [0.0, 0.0]),
+        ([-4.0, -2.0, 12.0], [0.0, 1.0]),
+        ([4.0, -2.0, 12.0], [1.0, 1.0]),
+        ([4.0, -2.0, 3.0], [1.0, 0.0]),
+    ]
+    .map(|(position, uv)| super::super::TerrainVertex::new(position, uv, 0, u32::MAX, 0xf0f0));
+    let vertices = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+        label: Some("Original terrain quad"),
+        contents: bytemuck::cast_slice(&terrain_vertices),
+        usage: wgpu::BufferUsages::VERTEX,
+    });
+    let indices = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+        label: Some("Original terrain quad indices"),
+        contents: bytemuck::cast_slice(&[0u32, 1, 2, 0, 2, 3]),
+        usage: wgpu::BufferUsages::INDEX,
+    });
+    let origin = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+        label: Some("Original camera-relative terrain origin"),
+        contents: bytemuck::cast_slice(&[0.0f32, 0.0, 0.0, 1.0 / 32768.0]),
+        usage: wgpu::BufferUsages::VERTEX,
+    });
+    let instance_attributes = wgpu::vertex_attr_array![5=>Float32x4];
+    let buffers = [
+        Some(wgpu::VertexBufferLayout {
+            array_stride: std::mem::size_of::<super::super::TerrainVertex>() as u64,
+            step_mode: wgpu::VertexStepMode::Vertex,
+            attributes: &super::super::TERRAIN_ATTRIBUTES,
+        }),
+        Some(wgpu::VertexBufferLayout {
+            array_stride: 16,
+            step_mode: wgpu::VertexStepMode::Instance,
+            attributes: &instance_attributes,
+        }),
+    ];
+    let size = [64, 48];
+    let hud = crate::hud::HudBatch::new(size);
+    let frame = original_world_frame(&hud);
+    let texture = |label, format, usage| {
+        device.create_texture(&wgpu::TextureDescriptor {
+            label: Some(label),
+            size: wgpu::Extent3d {
+                width: size[0],
+                height: size[1],
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format,
+            usage,
+            view_formats: &[],
+        })
+    };
+    let world = texture(
+        "Original world target",
+        wgpu::TextureFormat::Rgba8Unorm,
+        wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::RENDER_ATTACHMENT,
+    );
+    let depth = texture(
+        "Original world reverse depth",
+        wgpu::TextureFormat::Depth32Float,
+        wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::RENDER_ATTACHMENT,
+    );
+    let output = texture(
+        "Real author pack float output",
+        wgpu::TextureFormat::Rgba32Float,
+        wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+    );
+    let world_view = world.create_view(&Default::default());
+    let depth_view = depth.create_view(&Default::default());
+    let output_view = output.create_view(&Default::default());
+    let readback = |label, row| {
+        device.create_buffer(&wgpu::BufferDescriptor {
+            label: Some(label),
+            size: u64::from(row * size[1]),
+            usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            mapped_at_creation: false,
+        })
+    };
+    let color_readback = readback("Real pack float pixel readback", size[0] * 16);
+    let depth_readback = readback("Real pack terrain depth readback", size[0] * 4);
+    let output_folder =
+        std::env::var_os("HORIZON_SHADER_TEST_OUTPUT").map(std::path::PathBuf::from);
+    let mut reports = Vec::new();
+    for entry in found {
+        assert!(
+            entry.problem.is_none(),
+            "{}: {:?}",
+            entry.name,
+            entry.problem
+        );
+        let pack = Pack::open(&entry.path).unwrap();
+        let macros = Macros::standard();
+        let properties = Properties::parse(
+            &pack.read_text("shaders.properties").unwrap_or_default(),
+            &macros,
+        );
+        let mut post = load_post(
+            &pack,
+            &horizon_shaders::dimension_folder(&pack, 0),
+            &properties,
+            &macros,
+            &GameInputs {
+                terrain: Some(atlas.terrain_inputs(false)),
+                ..Default::default()
+            },
+        );
+        post.custom.set_biomes(ORIGINAL_BIOMES);
+        assert!(post.notes.is_empty(), "{}: {:?}", entry.name, post.notes);
+        assert!(
+            post.terrain.is_some(),
+            "{}: actual terrain program required",
+            entry.name
+        );
+        assert!(
+            post.programs
+                .iter()
+                .any(|program| program.group == Group::Final),
+            "{}: author final pass required",
+            entry.name
+        );
+        let expected_post = post.programs.len();
+        let expected_shadow = post.shadow.is_some();
+        let mut renderer = PackPost::new(
+            &device,
+            &queue,
+            post,
+            wgpu::TextureFormat::Rgba32Float,
+            World {
+                atlas: Some((atlas.view.clone(), atlas.size())),
+                lightmap: lightmap.clone(),
+                terrain: Some(Geometry {
+                    buffers: &buffers,
+                    table: None,
+                    depth_write: true,
+                    atlas: None,
+                    ids: None,
+                    cull: false,
+                }),
+                block_ids: &[-1, -1],
+                celestial: None,
+                clouds: None,
+                weather: false,
+                hand: false,
+            },
+        );
+        assert!(
+            renderer.terrain.is_some()
+                && renderer
+                    .passes
+                    .iter()
+                    .any(|pass| pass.group == Group::Final),
+            "{}: real geometry/final pipeline missing: {:?}",
+            entry.name,
+            renderer.notes
+        );
+        assert_eq!(
+            renderer.passes.len(),
+            expected_post,
+            "{}: required post pipeline skipped: {:?}",
+            entry.name,
+            renderer.notes
+        );
+        assert_eq!(
+            renderer.shadow_terrain.is_some(),
+            expected_shadow,
+            "{}: shadow terrain pipeline skipped",
+            entry.name
+        );
+        assert!(
+            !renderer.notes.iter().any(|note| note.contains("skipped")
+                || note.contains("not provided yet")
+                || note.contains("failed")),
+            "{}: {:?}",
+            entry.name,
+            renderer.notes
+        );
+        let mut terrain_draws = 0;
+        for _ in 0..3 {
+            let mut encoder = device.create_command_encoder(&Default::default());
+            encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("Original world clear"),
+                color_attachments: &[attach(
+                    &world_view,
+                    wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(wgpu::Color {
+                            r: 0.15,
+                            g: 0.3,
+                            b: 0.5,
+                            a: 1.0,
+                        }),
+                        store: wgpu::StoreOp::Store,
+                    },
+                )],
+                depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                    view: &depth_view,
+                    depth_ops: Some(wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(0.0),
+                        store: wgpu::StoreOp::Store,
+                    }),
+                    stencil_ops: None,
+                }),
+                ..Default::default()
+            });
+            let mut draw = |pass: &mut wgpu::RenderPass<'_>,
+                            list,
+                            _: &dyn Fn(&mut wgpu::RenderPass<'_>, u32)| {
+                if matches!(list, TerrainList::Solid | TerrainList::ShadowSolid) {
+                    pass.set_vertex_buffer(0, vertices.slice(..));
+                    pass.set_vertex_buffer(1, origin.slice(..));
+                    pass.set_index_buffer(indices.slice(..), wgpu::IndexFormat::Uint32);
+                    pass.draw_indexed(0..6, 0, 0..1);
+                    terrain_draws += 1;
+                }
+            };
+            renderer.run(
+                &device,
+                &queue,
+                &mut encoder,
+                &world_view,
+                &depth_view,
+                &output_view,
+                &frame,
+                &frame.pack,
+                size,
+                size,
+                &[],
+                &mut draw,
+            );
+            queue.submit([encoder.finish()]);
+            device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+        }
+        assert!(
+            terrain_draws >= 3,
+            "{}: author terrain program never drew",
+            entry.name
+        );
+        let mut encoder = device.create_command_encoder(&Default::default());
+        for (source, target, bytes_per_row, aspect) in [
+            (
+                &output,
+                &color_readback,
+                size[0] * 16,
+                wgpu::TextureAspect::All,
+            ),
+            (
+                &renderer.targets.as_ref().unwrap().depth_texture,
+                &depth_readback,
+                size[0] * 4,
+                wgpu::TextureAspect::DepthOnly,
+            ),
+        ] {
+            encoder.copy_texture_to_buffer(
+                wgpu::TexelCopyTextureInfo {
+                    aspect,
+                    ..source.as_image_copy()
+                },
+                wgpu::TexelCopyBufferInfo {
+                    buffer: target,
+                    layout: wgpu::TexelCopyBufferLayout {
+                        offset: 0,
+                        bytes_per_row: Some(bytes_per_row),
+                        rows_per_image: None,
+                    },
+                },
+                source.size(),
+            );
+        }
+        queue.submit([encoder.finish()]);
+        let map = |buffer: &wgpu::Buffer| {
+            let (tx, rx) = std::sync::mpsc::sync_channel(1);
+            buffer
+                .slice(..)
+                .map_async(wgpu::MapMode::Read, move |result| {
+                    let _ = tx.send(result);
+                });
+            device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+            rx.recv().unwrap().unwrap();
+        };
+        map(&color_readback);
+        map(&depth_readback);
+        let pixels = color_readback.slice(..).get_mapped_range().unwrap();
+        let values: &[f32] = bytemuck::cast_slice(&pixels);
+        assert!(
+            values.iter().all(|value| value.is_finite()),
+            "{}: nonfinite output pixels",
+            entry.name
+        );
+        let depth_pixels = depth_readback.slice(..).get_mapped_range().unwrap();
+        let depths: &[f32] = bytemuck::cast_slice(&depth_pixels);
+        let covered = depths.iter().filter(|&&value| value < 0.9999).count();
+        assert!(
+            covered > 32 && covered < depths.len() - 32,
+            "{}: fixture terrain depth coverage invalid: {covered}/{}",
+            entry.name,
+            depths.len()
+        );
+        let luminance: Vec<f32> = values
+            .chunks_exact(4)
+            .map(|pixel| pixel[..3].iter().sum::<f32>())
+            .collect();
+        let min = luminance.iter().copied().fold(f32::INFINITY, f32::min);
+        let max = luminance.iter().copied().fold(f32::NEG_INFINITY, f32::max);
+        assert!(
+            max > 0.05 && max - min > 0.02,
+            "{}: output was black/constant: luminance {min}..{max}",
+            entry.name
+        );
+        println!(
+            "{}: author terrain/shadow/post execution; {covered} terrain depth pixels; finite output luminance {min}..{max}",
+            entry.name
+        );
+        if let Some(folder) = &output_folder {
+            std::fs::create_dir_all(folder).unwrap();
+            let basename: String = entry
+                .name
+                .chars()
+                .map(|c| {
+                    if c.is_ascii_alphanumeric() || c == '-' || c == '_' {
+                        c
+                    } else {
+                        '_'
+                    }
+                })
+                .collect();
+            let rgba: Vec<u8> = values
+                .iter()
+                .map(|&value| (value.clamp(0.0, 1.0) * 255.0).round() as u8)
+                .collect();
+            std::fs::write(
+                folder.join(format!("{basename}.png")),
+                png_bytes(size[0], size[1], png::ColorType::Rgba, &rgba),
+            )
+            .unwrap();
+        }
+        reports.push(serde_json::json!({
+            "pack": entry.name, "dimension": 0, "flat_terrain": false,
+            "frames": 3, "size": size, "post_pipelines": expected_post,
+            "terrain_depth_pixels": covered, "total_pixels": depths.len(),
+            "finite_float_output": true, "rgb_sum_min": min, "rgb_sum_max": max,
+        }));
+        drop(pixels);
+        drop(depth_pixels);
+        color_readback.unmap();
+        depth_readback.unmap();
+    }
+    if let Some(folder) = &output_folder {
+        let report = serde_json::json!({ "adapter": adapter.get_info().name,
+            "backend": "Vulkan", "cases": reports,
+            "limits": ["Original synthetic terrain only; no Minecraft assets, full world, gameplay or visual parity validation.",
+                "Native Windows DX12, Metal and player GPU performance remain untested."] });
+        std::fs::write(
+            folder.join("rendered-packs.json"),
+            serde_json::to_vec_pretty(&report).unwrap(),
+        )
+        .unwrap();
+    }
+}
