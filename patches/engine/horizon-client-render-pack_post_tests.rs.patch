+/// Executes the selected packs' actual terrain, shadows and post passes. The
+/// atlas/quad are original generated fixtures, never Mojang assets or copied
+/// pack programs. Read back float pixels as well as depth so validation cannot
+/// pass merely because a pipeline built or the vanilla clear was presented.
+#[test]
+#[ignore = "requires HORIZON_TEST_SHADER_PACKS and software/hardware Vulkan"]
+fn real_shader_packs_render_original_terrain_and_finite_pixels() {
+    use super::super::pack_atlas::PackAtlas;
+    use wgpu::util::DeviceExt;
+    let folder = std::env::var_os("HORIZON_TEST_SHADER_PACKS")
