+/// An item (or empty arm, id 0) in the first-person hand's vertex list.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct ItemSpan {
+    pub start: u32,
+    pub item_id: i32,
+}
+
+impl ItemSpan {
+    /// Starts a run, replacing an empty previous run and coalescing equal ids.
+    pub fn mark(spans: &mut Vec<Self>, start: usize, item_id: i32) {
+        let span = Self {
+            start: start as u32,
+            item_id,
+        };
+        match spans.last_mut() {
+            Some(last) if last.start == span.start => *last = span,
+            Some(last) if last.item_id == item_id => {}
+            _ => spans.push(span),
+        }
+    }
+}
+
 impl EntitySpan {
+    /// Drops markers whose geometry was removed by camera occlusion. The boundary
+    /// keeps the parent entity kind, with no item active for subsequent geometry.
+    pub fn truncate(spans: &mut Vec<Self>, vertices: usize) {
+        while spans
+            .last()
+            .is_some_and(|span| span.start as usize > vertices)
+        {
+            spans.pop();
+        }
+        if let Some(last) = spans
+            .last_mut()
+            .filter(|span| span.start as usize == vertices)
+        {
+            last.item_id = 0;
+        }
+    }
