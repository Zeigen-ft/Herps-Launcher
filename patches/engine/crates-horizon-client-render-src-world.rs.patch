     pub fn top_y(&self) -> i32 {
         self.layout().max_y()
     }
+    pub fn preview_hides(&self, [x, y, z]: [i32; 3]) -> bool {
+        self.preview_hidden
+            .get(&(x >> 4, z >> 4))
+            .and_then(|cells| cells.get(&[x, y, z]))
+            .is_some_and(|&state| self.block(x, y, z) == state)
+    }
+
+    pub fn hide_preview_blocks(&mut self, blocks: &[([i32; 3], BlockStateId)], hidden: bool) {
+        let layout = self.layout();
+        for &(p @ [x, y, z], state) in blocks {
+            let column = (x >> 4, z >> 4);
+            if hidden {
+                self.preview_hidden
+                    .entry(column)
+                    .or_default()
+                    .insert(p, state);
+            } else if let Some(cells) = self.preview_hidden.get_mut(&column) {
+                cells.remove(&p);
+                if cells.is_empty() {
+                    self.preview_hidden.remove(&column);
+                }
+            }
+            // Match the mesher's one-cell culling and AO neighbourhood.
+            for bx in [(x - 1) >> 4, (x + 1) >> 4] {
+                for bz in [(z - 1) >> 4, (z + 1) >> 4] {
+                    for sy in [y - 1, y, y + 1]
+                        .into_iter()
+                        .filter_map(|y| layout.section_index(y))
+                    {
+                        self.dirty_sections.insert((bx, sy as i32, bz));
+                    }
+                }
+            }
+        }
+    }
