+
+/// Covers every hand quad once, including unmarked empty arms and trailing effects.
+fn item_runs(quads: u32, spans: &[ItemSpan]) -> Vec<(u32, u32, i32)> {
+    let (mut cursor, mut item) = (0, 0);
+    let mut runs = Vec::new();
+    for span in spans {
+        let next = (span.start / 4).min(quads);
+        if next < cursor {
+            continue;
+        }
+        if next > cursor {
+            runs.push((cursor, next - cursor, item));
+        }
+        cursor = next;
+        item = span.item_id;
+    }
+    if cursor < quads {
+        runs.push((cursor, quads - cursor, item));
+    }
+    runs
 }
 
 #[cfg(test)]
 mod tests {
     use super::*;
+
+    #[test]
+    fn item_runs_preserve_arms_both_hands_and_trailing_effects() {
+        let spans = [
+            ItemSpan {
+                start: 8,
+                item_id: 1001,
+            },
+            ItemSpan {
+                start: 20,
+                item_id: 1002,
+            },
+            ItemSpan {
+                start: 28,
+                item_id: 0,
+            },
+        ];
+        assert_eq!(
+            item_runs(9, &spans),
+            [(0, 2, 0), (2, 3, 1001), (5, 2, 1002), (7, 2, 0)]
+        );
+        assert_eq!(item_runs(2, &[]), [(0, 2, 0)]);
+        assert!(item_runs(0, &spans).is_empty());
+    }
 
