+/// room for vector headers/capacity and shared-map bookkeeping in the estimate.
+const SURFACE_TILE_RESERVE: usize = 64 * 1024;
+fn columns_bytes(columns: &[Column]) -> usize {
+    std::mem::size_of_val(columns).saturating_add(columns.iter()
