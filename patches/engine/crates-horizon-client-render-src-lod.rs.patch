+/// Stage 1 intentionally caches a height surface rather than caves/voxel runs.
+/// Scanning from the top needs no temporary full-column span allocation.
+fn summarize_surface(chunk: &Chunk, kinds: &[u8]) -> Arc<[Column; 256]> {
+    let water_state = water_source(kinds);
+    Arc::new(std::array::from_fn(|i| {
+        let (x, z) = ((i & 15) as i32, (i >> 4) as i32);
+        let mut water = None;
+        let mut surface = None;
+        for y in (chunk.min_y()..chunk.min_y() + chunk.sections.len() as i32 * 16).rev() {
+            let mut state = BlockStateId(chunk.get(x, y, z));
+            let mut kind = kinds.get(state.0 as usize).copied().unwrap_or(0);
+            if kind & KEPT == 0 { continue; }
+            if kind & WATERY != 0 && let Some(pure) = water_state {
+                state = pure;
+                kind = kinds[pure.0 as usize];
+            }
+            if kind & FLUID != 0 {
+                water.get_or_insert((y + 1, state));
+            } else {
+                surface = Some(Surface { height: y + 1, state, water,
+                    biome: chunk.biome(x, y, z) });
+                break;
+            }
+        }
+        if surface.is_none() && let Some((height, state)) = water {
+            surface = Some(Surface { height: chunk.min_y(), state: BlockStateId(kinds.iter().position(|kind| kind & AIR != 0).unwrap_or(0) as u32),
+                water: Some((height, state)), biome: chunk.biome(x, height - 1, z) });
+        }
+        Column::from_surface(surface)
     }))
 }
