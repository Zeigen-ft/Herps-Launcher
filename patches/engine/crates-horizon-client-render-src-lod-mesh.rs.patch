     #[test]
+    fn received_heightmap_mesh_preserves_tint_and_clips_near_and_unknown_columns() {
+        let columns: Vec<_> = (0..256).map(|i| {
+            if i / 16 >= 8 { Column::default() } else {
+                Column::from_surface(Some(super::super::Surface {
+                    height: 64, state: BlockStateId(1), water: None, biome: 7,
+                }))
+            }
+        }).collect();
+        // A level-1 tile covers 2x2 chunks. Only its upper half is known;
+        // the left near chunk is excluded. Exactly one 16x16 top remains.
+        let covered = [(0, 0), (0, 1)].into_iter().collect();
+        let generated = mesh_columns(TileKey { x: 0, z: 0, level: 1 }, &columns,
+            &covered, Some([0, 0, 1, 2]), |span, dir, at| {
+                let mut result = material(span, dir, at);
+                result.faces[0].as_mut().unwrap().color = if span.biome == 7 { 0xff123456 } else { 0 };
+                result
+            });
+        let mut top_area = 0.0;
+        for quad in generated.solid.as_chunks::<4>().0 {
+            if !quad.iter().all(|v| v.pos[1] == 64.0) { continue; }
+            let lo_x = quad.iter().map(|v| v.pos[0]).reduce(f32::min).unwrap();
+            let hi_x = quad.iter().map(|v| v.pos[0]).reduce(f32::max).unwrap();
+            let lo_z = quad.iter().map(|v| v.pos[2]).reduce(f32::min).unwrap();
+            let hi_z = quad.iter().map(|v| v.pos[2]).reduce(f32::max).unwrap();
+            assert!(lo_x >= 16.0 && hi_x <= 32.0 && lo_z >= 0.0 && hi_z <= 16.0);
+            assert!(quad.iter().all(|v| v.color == 0xff123456));
+            top_area += (hi_x - lo_x) * (hi_z - lo_z);
+        }
+        assert_eq!(top_area, 256.0);
+        assert!(generated.translucent.is_empty());
+    }
+    fn observed_mesh(
+        key: TileKey, columns: &[Column], covered: &FxHashSet<(i32, i32)>,
+        bounds: Option<[i32; 4]>, neighbors: &[Vec<EdgeColumn>; 4],
+    ) -> SectionMesh {
+        mesh_columns_with_mode(key, columns, covered, bounds, neighbors, &[], true, material)
+    }
+    fn surface(height: i32, water: Option<i32>) -> Column {
+        Column::from_surface(Some(super::super::Surface {
+            height, state: BlockStateId(1), water: water.map(|y| (y, BlockStateId(2))), biome: 0,
+        }))
+    }
+    #[test]
+    fn observed_unknown_land_edges_have_no_world_floor_curtains() {
+        for level in [0, 1, 4, 6] {
+            for (x, z) in [(0, 0), (8, 8), (15, 15)] {
+                let mut columns = columns();
+                columns[z * CELLS + x] = surface(80, None);
+                let key = TileKey { x: -1, z: -2, level };
+                let generated = observed_mesh(key, &columns, &FxHashSet::default(), None,
+                    &std::array::from_fn(|_| Vec::new()));
+                assert_eq!(generated.solid.len(), 4, "only the known top: level={level}, x={x}, z={z}");
+                assert!(normal(generated.solid.as_chunks::<4>().0.first().unwrap()).y > 0.0);
+                assert!(generated.solid.iter().all(|v| v.pos[1] == 80.0));
+                // Reproduce the original defect through the preserved legacy path.
+                let legacy = mesh_columns(key, &columns, &FxHashSet::default(), None, material);
+                assert!(legacy.solid.iter().any(|v| v.pos[1] == crate::chunk::MIN_Y as f32));
+            }
+        }
+    }
+    #[test]
+    fn observed_unknown_ocean_edges_keep_surface_without_water_curtains() {
+        let mut columns = columns();
+        columns[8 * CELLS + 8] = surface(20, Some(64));
+        let generated = observed_mesh(TileKey { x: 0, z: 0, level: 2 }, &columns,
+            &FxHashSet::default(), None, &std::array::from_fn(|_| Vec::new()));
+        assert_eq!(generated.solid.len(), 4);
+        assert_eq!(generated.translucent.len(), 4);
+        for quad in generated.translucent.as_chunks::<4>().0 {
+            assert!(normal(quad).y > 0.0);
+            assert!(quad.iter().all(|v| (v.pos[1] - (64.0 - 1.0 / 9.0)).abs() < 0.001));
+        }
+    }
