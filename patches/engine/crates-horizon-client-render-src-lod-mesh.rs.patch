+    #[test]
+    fn observed_known_neighbors_keep_real_cliffs_and_cross_tile_steps() {
+        for across_tile in [false, true] {
+            let mut columns = columns();
+            let mut neighbors = std::array::from_fn(|_| Vec::new());
+            let x = if across_tile { 15 } else { 8 };
+            columns[8 * CELLS + x] = surface(80, None);
+            if across_tile {
+                neighbors[1].push(EdgeColumn { start: 8, end: 9, column: surface(60, None) });
+            } else { columns[8 * CELLS + x + 1] = surface(60, None); }
+            let generated = observed_mesh(TileKey { x: 0, z: 0, level: 0 }, &columns,
+                &FxHashSet::default(), None, &neighbors);
+            let walls: Vec<_> = generated.solid.as_chunks::<4>().0.iter()
+                .filter(|q| normal(q).y == 0.0).collect();
+            assert_eq!(walls.len(), 1);
+            let wall = walls[0];
+            assert_eq!(wall.iter().map(|v| v.pos[1]).reduce(f32::min), Some(60.0));
+            assert_eq!(wall.iter().map(|v| v.pos[1]).reduce(f32::max), Some(80.0));
+        }
+    }
+    #[test]
+    fn observed_near_boundary_seals_are_finite_and_do_not_overlap_near_tops() {
+        let columns = vec![surface(80, None); CELLS * CELLS];
+        let covered = [(0, 0)].into_iter().collect();
+        let generated = observed_mesh(TileKey { x: 0, z: 0, level: 1 }, &columns,
+            &covered, Some([0, 0, 16, 16]), &std::array::from_fn(|_| Vec::new()));
+        let mut walls = 0;
+        let mut top_area = 0.0;
+        for quad in generated.solid.as_chunks::<4>().0 {
+            assert!(quad.iter().all(|v| v.pos[1] >= 78.0));
+            if normal(quad).y == 0.0 { walls += 1; } else {
+                assert!(normal(quad).y > 0.0);
+                let x = quad.iter().map(|v| v.pos[0]).reduce(f32::min).unwrap();
+                let z = quad.iter().map(|v| v.pos[2]).reduce(f32::min).unwrap();
+                assert!(x >= 16.0 || z >= 16.0);
+                top_area += normal(quad).y;
+            }
+        }
+        assert!(walls > 0);
+        assert_eq!(top_area, 32.0 * 32.0 - 16.0 * 16.0);
+    }
